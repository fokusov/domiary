# Local 1C infobase used for development (owner's working base)
/base/

# Mobile application publication and build output
/pub/
*.apk
*.aab

# Signing keys must never be committed
*.keystore
*.jks

# Tool caches and temporary build directories
/.build/
src/.build/

# Generated by the 1C configuration dump, rebuilt on every dump
src/ConfigDumpInfo.xml
src/DumpFilesIndex.txt

# 1C platform temporary and lock files
*.1CL
*.cfl
1Cv8Log/

# Editors and OS
.vscode/
.idea/
Thumbs.db
.DS_Store
