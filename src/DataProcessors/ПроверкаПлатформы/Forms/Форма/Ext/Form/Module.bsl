// Spike T-001: проверка возможностей мобильной платформы 8.5.
// Код только для ветки spike, в main не попадает.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	МинутДоУведомления = 2;
	КоличествоЗаписей = 1000;
	СтрокаПоиска = "фильтр";

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Информация = Новый СистемнаяИнформация;
	Записать(СтрШаблон("Платформа %1, %2, ОС %3",
		Информация.ВерсияПриложения, Информация.ТипПлатформы, Информация.ВерсияОС));
	Записать(ПроверкаПлатформыСервер.СостояниеБазы());

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СделатьФотоОбработка(Команда)

#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда
	Если Не СредстваМультимедиа.ПоддерживаетсяФотоснимок() Тогда
		Записать("Фото: камера не поддерживается");
		Возврат;
	КонецЕсли;
	Данные = СредстваМультимедиа.СделатьФотоснимок(, , 70);
	Если Данные = Неопределено Тогда
		Записать("Фото: съёмка отменена");
		Возврат;
	КонецЕсли;
	Записать(ПроверкаПлатформыСервер.СохранитьФото(Данные.ПолучитьДвоичныеДанные(), "камера"));
#Иначе
	Записать("Фото: камера доступна только на телефоне");
#КонецЕсли

КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьФотоОбработка(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Выберите фото";
	ПараметрыДиалога.Фильтр = "Изображения|*.jpg;*.jpeg;*.png;*.heic;*.webp";

	Попытка
		Описание = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыДиалога, УникальныйИдентификатор);
	Исключение
		Записать("Галерея: ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Описание = Неопределено Или Описание.ПомещениеФайлаОтменено Тогда
		Записать("Галерея: выбор отменён");
		Возврат;
	КонецЕсли;
	Записать(ПроверкаПлатформыСервер.СохранитьФотоИзХранилища(Описание.Адрес, Описание.СсылкаНаФайл.Имя));

КонецПроцедуры

&НаКлиенте
Асинх Процедура СканироватьДокументОбработка(Команда)

#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда
	Если Не СредстваМультимедиа.ПоддерживаетсяСканированиеДокументов() Тогда
		Записать("Сканирование: не поддерживается");
		Возврат;
	КонецЕсли;
	Страницы = Ждать СредстваМультимедиа.СканироватьДокументыАсинх("Сканирование документа");
	Если Страницы = Неопределено Тогда
		Записать("Сканирование: отменено");
		Возврат;
	КонецЕсли;
	Для Каждого Страница Из Страницы Цикл
		Данные = Страница.ДанныеИзображения;
		Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
			Данные = Данные.ПолучитьДвоичныеДанные();
		КонецЕсли;
		Записать(ПроверкаПлатформыСервер.СохранитьФото(Данные, "скан"));
	КонецЦикла;
#Иначе
	Записать("Сканирование: доступно только на телефоне");
#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ЗапланироватьУведомлениеОбработка(Команда)

#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда
	Уведомление = Новый ДоставляемоеУведомление;
	Уведомление.Заголовок = "Domiary";
	Уведомление.Текст = "Пробное напоминание: заменить фильтр воды";
	Уведомление.ДатаПоявленияУниверсальноеВремя = УниверсальноеВремя(ТекущаяДата()) + МинутДоУведомления * 60;
	Уведомление.Данные = "spike-T-001";
	ДоставляемыеУведомления.ДобавитьЛокальноеУведомление(Уведомление);
	Записать(СтрШаблон("Уведомление запланировано через %1 мин (UTC %2)",
		МинутДоУведомления, Уведомление.ДатаПоявленияУниверсальноеВремя));
#Иначе
	Записать("Уведомления: доступны только на телефоне");
#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьУведомленияОбработка(Команда)

#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда
	ДоставляемыеУведомления.ОтменитьЛокальныеУведомления();
	Записать("Уведомления: запланированные отменены");
#Иначе
	Записать("Уведомления: доступны только на телефоне");
#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ПоделитьсяФайломОбработка(Команда)

#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда
	Выгрузка = ПроверкаПлатформыСервер.СформироватьВыгрузку();
	Записать(Выгрузка.Журнал);

	ИмяФайла = КаталогВременныхФайлов() + "domiary-export.json";
	Выгрузка.Данные.Записать(ИмяФайла);
	Данные = Новый ДанныеМультимедиа(ИмяФайла);

	Попытка
		Найдены = СредстваПередачиДанныхНаУстройстве.ПоделитьсяДанными(Данные, "application/json", "Domiary: выгрузка");
		Записать("Поделиться: " + ?(Найдены, "диалог показан", "нет подходящих приложений"));
	Исключение
		Записать("Поделиться: ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
#Иначе
	Записать("Поделиться: доступно только на телефоне");
#КонецЕсли

КонецПроцедуры

&НаКлиенте
Асинх Процедура СохранитьФайлОбработка(Команда)

	Выгрузка = ПроверкаПлатформыСервер.СформироватьВыгрузку();
	Записать(Выгрузка.Журнал);
	Адрес = ПоместитьВоВременноеХранилище(Выгрузка.Данные, УникальныйИдентификатор);

	Попытка
		Результат = Ждать ПолучитьФайлССервераАсинх(Адрес, "domiary-export.json");
		Записать("Сохранение: " + ?(Результат = Неопределено, "отменено", "файл сохранён"));
	Исключение
		Записать("Сохранение: ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ПрочитатьФайлОбработка(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Выберите файл выгрузки";

	Попытка
		Описание = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыДиалога, УникальныйИдентификатор);
	Исключение
		Записать("Чтение файла: ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Описание = Неопределено Или Описание.ПомещениеФайлаОтменено Тогда
		Записать("Чтение файла: выбор отменён");
		Возврат;
	КонецЕсли;
	Записать(ПроверкаПлатформыСервер.ПрочитатьФайл(Описание.Адрес, Описание.СсылкаНаФайл.Имя));

КонецПроцедуры

&НаКлиенте
Процедура СгенерироватьДанныеОбработка(Команда)

	Записать(ПроверкаПлатформыСервер.СгенерироватьДанные(КоличествоЗаписей));

КонецПроцедуры

&НаКлиенте
Процедура ЗамеритьПоискОбработка(Команда)

	Записать(ПроверкаПлатформыСервер.ЗамеритьПоиск(СтрокаПоиска));

КонецПроцедуры

&НаКлиенте
Процедура ЗамеритьСписокОбработка(Команда)

	Записать(ПроверкаПлатформыСервер.ЗамеритьСписок());

КонецПроцедуры

&НаКлиенте
Процедура УдалитьПробныеДанныеОбработка(Команда)

	Записать(ПроверкаПлатформыСервер.УдалитьПробныеДанные());

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВерсиюОбработка(Команда)

	Записать(ПроверкаПлатформыСервер.УвеличитьВерсиюДанных());

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСостояниеОбработка(Команда)

	Записать(ПроверкаПлатформыСервер.СостояниеБазы());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Записать(Текст)

	Журнал = Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + "  " + Текст + Символы.ПС + Журнал;

КонецПроцедуры

#КонецОбласти
