// Дом: квартира, дача, гараж — верхний уровень хозяйства (METADATA §2.1).
// Вместо удаления дом уходит в архив вместе с местами (сервис Дома).

Перем НоваяЗапись; // признак новой записи между ПередЗаписью и ПриЗаписи

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Тип.Пустая() Тогда
		Тип = Перечисления.ТипыОбъектовНедвижимости.Квартира;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	НоваяЗапись = ЭтоНовый();

	Если ПометкаУдаления И СодержитМеста() Тогда
		Отказ = Истина;
		СообщитьПользователю(НСтр("ru = 'В этом доме есть места. Перенесите их в архив вместе с домом'"));
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	// Только что созданный дом становится выбранным: с него начинают знакомство.
	Если НоваяЗапись Тогда
		Дома.ЗапомнитьПоследнийДом(Ссылка);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ПустаяСтрока(Наименование) Тогда
		Отказ = Истина;
		СообщитьПользователю(НСтр("ru = 'Укажите название — без него дом не найти в поиске.'"),
			"Наименование");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Есть ли у дома хотя бы одно место, включая архивные.
Функция СодержитМеста()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Справочник.МестаХранения КАК МестаХранения
	|ГДЕ
	|	МестаХранения.Владелец = &Владелец
	|	И НЕ МестаХранения.ПометкаУдаления";
	Запрос.УстановитьПараметр("Владелец", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Выборка.Количество > 0;

КонецФункции

Процедура СообщитьПользователю(Текст, Поле = "")

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
