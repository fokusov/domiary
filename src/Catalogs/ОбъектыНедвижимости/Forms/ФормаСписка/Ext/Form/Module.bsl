#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьОтборАрхива(Ложь);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьАрхив(Команда)

	Кнопка = Элементы.ФормаПоказатьАрхив;
	Кнопка.Пометка = НЕ Кнопка.Пометка;
	УстановитьОтборАрхива(Кнопка.Пометка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// По умолчанию архив скрыт: список показывает только то, чем пользуются.
&НаСервере
Процедура УстановитьОтборАрхива(ПоказыватьАрхив)

	// Убираем только своё условие: отбор по дому, с которым открыт список, остаётся.
	Отбор = Список.Отбор;
	ПолеАрхив = Новый ПолеКомпоновкиДанных("Архив");
	Для Индекс = -Отбор.Элементы.Количество() + 1 По 0 Цикл
		Элемент = Отбор.Элементы[-Индекс];
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") И Элемент.ЛевоеЗначение = ПолеАрхив Тогда
			Отбор.Элементы.Удалить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Если НЕ ПоказыватьАрхив Тогда
		Элемент = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Архив");
		Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Элемент.ПравоеЗначение = Ложь;
		Элемент.Использование = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
