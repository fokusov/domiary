#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда
		Заголовок = НСтр("ru = 'Новый документ'");
	Иначе
		Заголовок = Объект.Наименование;
	КонецЕсли;

	// Изображение показываем прямо в карточке, остальные файлы — только открываем.
	АдресПросмотра = Вложения.ПоместитьДляПросмотра(Объект.Ссылка, УникальныйИдентификатор);
	Элементы.Просмотр.Видимость = АдресПросмотра <> "";
	Элементы.ОткрытьФайл.Видимость = Вложения.ЕстьДанные(Объект.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьФайлОбработка(Команда)

	ВложенияКлиент.ОткрытьФайл(Объект.Ссылка, Объект.ИмяФайла, УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти
