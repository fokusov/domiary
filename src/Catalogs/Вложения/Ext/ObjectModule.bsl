// Документ (вложение): файл, связанный с вещью или домом (ADR-002). Двоичные
// данные лежат в регистре ДанныеВложений, объект хранит только метаданные файла.

#Область ОбработчикиСобытий

// При пометке на удаление убираем файл из основного фото вещи и стираем данные
// файла — в одной транзакции с пометкой. У объекта справочника нет события
// «при установке пометки удаления», поэтому пометка ловится при записи.
Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ПометкаУдаления Или ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Если Ссылка.ПометкаУдаления Тогда
		Возврат; // пометка уже стояла
	КонецЕсли;

	ОчиститьОсновноеФотоВещи();
	СтеретьДанныеФайла();
	Хроника.УдалитьПоИсточнику(Ссылка);

КонецПроцедуры

// При обычной записи обновляем событие истории вложения (ADR-003): так событие
// совпадает с перестроенным даже после переименования документа. Помеченный
// на удаление документ событий не пишет: их удалил ПередЗаписью выше.
Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Или ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	Хроника.ОбновитьПоИсточнику(Ссылка, Вложения.СобытияВложения(Ссылка));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Если файл — основное фото вещи, очищаем фото у вещи.
Процедура ОчиститьОсновноеФотоВещи()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Вещи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Вещи КАК Вещи
	|ГДЕ
	|	Вещи.ОсновноеФото = &Вложение";
	Запрос.УстановитьПараметр("Вложение", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	Вещь = Выборка.Ссылка.ПолучитьОбъект();
	Если Вещь = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Вещь.ОсновноеФото = Справочники.Вложения.ПустаяСсылка();
	Вещь.Записать();

КонецПроцедуры

// Стирает данные файла из регистра ДанныеВложений.
Процедура СтеретьДанныеФайла()

	Набор = РегистрыСведений.ДанныеВложений.СоздатьНаборЗаписей();
	Набор.Отбор.Вложение.Установить(Ссылка);
	Набор.Записать(Истина);

КонецПроцедуры

#КонецОбласти
