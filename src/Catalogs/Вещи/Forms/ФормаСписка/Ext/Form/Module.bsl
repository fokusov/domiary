#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проданные, переданные и выбывшие вещи по умолчанию не показываем.
	Скрытые = Новый СписокЗначений;
	Скрытые.Добавить(Перечисления.СтатусыВещей.Продано);
	Скрытые.Добавить(Перечисления.СтатусыВещей.Передано);
	Скрытые.Добавить(Перечисления.СтатусыВещей.Выбыло);

	Элемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
	Элемент.ПравоеЗначение = Скрытые;
	Элемент.Использование = Истина;

КонецПроцедуры

#КонецОбласти
