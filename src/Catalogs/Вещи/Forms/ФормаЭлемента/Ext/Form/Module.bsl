#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Новая вещь: фото, название и место, подробности свёрнуты (UX_MAP §3.4).
	// Документы появляются после первого сохранения: им нужна ссылка на вещь.
	Если Объект.Ссылка.Пустая() Тогда
		Заголовок = НСтр("ru = 'Новая вещь'");
		Элементы.ГруппаПодробнее.Скрыть();
		Элементы.ГруппаДокументы.Видимость = Ложь;
		Элементы.ГруппаИстория.Видимость = Ложь;
	Иначе
		Заголовок = Объект.Наименование;
	КонецЕсли;

	Документы.Параметры.УстановитьЗначениеПараметра("Предмет", Объект.Ссылка);
	История.Параметры.УстановитьЗначениеПараметра("Объект", Объект.Ссылка);

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ПоказатьФото();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	Заголовок = ТекущийОбъект.Наименование;
	Элементы.ГруппаДокументы.Видимость = Истина;
	Документы.Параметры.УстановитьЗначениеПараметра("Предмет", ТекущийОбъект.Ссылка);
	Элементы.ГруппаИстория.Видимость = Истина;
	История.Параметры.УстановитьЗначениеПараметра("Объект", ТекущийОбъект.Ссылка);
	Элементы.История.Обновить();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура МестоПриИзменении(Элемент)

	МестоПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДатаПокупкиПриИзменении(Элемент)

	// Гарантия обычно начинается с покупки.
	Объект.ГарантияНачало = Объект.ДатаПокупки;
	ПересчитатьОкончаниеГарантии();

КонецПроцедуры

&НаКлиенте
Процедура ГарантияМесяцевПриИзменении(Элемент)

	ПересчитатьОкончаниеГарантии();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИстория

// Запись истории — служебная строка: карточку не открываем.
&НаКлиенте
Процедура ИсторияВыборСтроки(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Основное фото вещи с камеры (UX_MAP §3.4).
&НаКлиенте
Процедура ДобавитьФотоОбработка(Команда)

	Данные = ВложенияКлиент.СнятьФото();
	Если Данные = Неопределено Тогда
		Возврат; // нет камеры или съёмка отменена — сообщение уже показано
	КонецЕсли;

	// Сначала сохраняем карточку: новой вещи нужна ссылка для фото, а правки
	// существующей не должны пропасть при перечитывании формы после снимка.
	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		Если НЕ Записать() Тогда
			Возврат; // запись не прошла — сообщение уже показано
		КонецЕсли;
	КонецЕсли;

	Попытка
		ВложенияКлиент.УстановитьФото(УникальныйИдентификатор, Объект.Ссылка, Данные,
			ВложенияКлиент.ИмяСнимка());
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Прочитать();

КонецПроцедуры

// Снимок документа вещи: чек, гарантийный талон (UX_MAP §3.3).
&НаКлиенте
Процедура СфотографироватьДокументОбработка(Команда)

	Данные = ВложенияКлиент.СнятьФото();
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДобавитьДокументИзДанных(Данные, ВложенияКлиент.ИмяСнимка());

КонецПроцедуры

// Файл с устройства: инструкция в PDF, гарантия из письма (UX_MAP §3.3).
&НаКлиенте
Асинх Процедура ДобавитьФайлОбработка(Команда)

	Выбор = Ждать ВложенияКлиент.ВыбратьФайл(УникальныйИдентификатор);
	Если Выбор = Неопределено Тогда
		Возврат; // выбор отменён или не открылся — сообщение уже показано
	КонецЕсли;

	Попытка
		Вложения.ДобавитьИзХранилища(Объект.Ссылка, Выбор.Адрес, Выбор.Имя);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Элементы.Документы.Обновить();

КонецПроцедуры

// Скан документа камерой: каждая страница становится отдельным документом.
&НаКлиенте
Асинх Процедура СканироватьДокументОбработка(Команда)

	Страницы = Ждать ВложенияКлиент.Отсканировать();
	Для Номер = 0 По Страницы.ВГраница() Цикл
		ДобавитьДокументИзДанных(Страницы[Номер], ВложенияКлиент.ИмяСканаСтраницы(Номер + 1));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Дом вещи всегда совпадает с домом её места.
&НаСервере
Процедура МестоПриИзмененииНаСервере()

	Если ЗначениеЗаполнено(Объект.Место) Тогда
		Объект.ОбъектНедвижимости = Объект.Место.Владелец;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьОкончаниеГарантии()

	Начало = ?(ЗначениеЗаполнено(Объект.ГарантияНачало), Объект.ГарантияНачало, Объект.ДатаПокупки);
	Окончание = ВещиКлиентСервер.ОкончаниеГарантии(Начало, Объект.ГарантияМесяцев);
	Если ЗначениеЗаполнено(Окончание) Тогда
		Объект.ГарантияОкончание = Окончание;
	КонецЕсли;

КонецПроцедуры

// Помещает основное фото во временное хранилище для поля «Фото».
&НаСервере
Процедура ПоказатьФото()

	АдресФото = Вложения.ПоместитьДляПросмотра(Объект.ОсновноеФото, УникальныйИдентификатор);

КонецПроцедуры

// Сохраняет снимок или скан как документ вещи и обновляет список документов.
&НаКлиенте
Процедура ДобавитьДокументИзДанных(Данные, ИмяФайла)

	Попытка
		ВложенияКлиент.ДобавитьФайл(УникальныйИдентификатор, Объект.Ссылка, Данные, ИмяФайла);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Элементы.Документы.Обновить();

КонецПроцедуры

#КонецОбласти
