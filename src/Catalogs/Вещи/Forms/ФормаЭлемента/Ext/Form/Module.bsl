#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Новая вещь: фото, название и место, подробности свёрнуты (UX_MAP §3.4).
	// Документы появляются после первого сохранения: им нужна ссылка на вещь.
	Если Объект.Ссылка.Пустая() Тогда
		Заголовок = НСтр("ru = 'Новая вещь'");
		Элементы.ГруппаПодробнее.Скрыть();
		Элементы.ГруппаДокументы.Видимость = Ложь;
	Иначе
		Заголовок = Объект.Наименование;
	КонецЕсли;

	Документы.Параметры.УстановитьЗначениеПараметра("Предмет", Объект.Ссылка);

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ПоказатьФото();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	Заголовок = ТекущийОбъект.Наименование;
	Элементы.ГруппаДокументы.Видимость = Истина;
	Документы.Параметры.УстановитьЗначениеПараметра("Предмет", ТекущийОбъект.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура МестоПриИзменении(Элемент)

	МестоПриИзмененииНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Фото вещи с камеры (UX_MAP §3.4).
&НаКлиенте
Процедура ДобавитьФотоОбработка(Команда)

	// T-016: съёмка и сохранение основного фото.
	ПоказатьПредупреждение(, НСтр("ru = \'Пока не работает\'"));

КонецПроцедуры

&НаКлиенте
Процедура СфотографироватьДокументОбработка(Команда)

	// T-016: снимок документа (чек, гарантийный талон).
	ПоказатьПредупреждение(, НСтр("ru = \'Пока не работает\'"));

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлОбработка(Команда)

	// T-016: выбор файла на устройстве.
	ПоказатьПредупреждение(, НСтр("ru = \'Пока не работает\'"));

КонецПроцедуры

&НаКлиенте
Процедура СканироватьДокументОбработка(Команда)

	// T-016: сканирование документа.
	ПоказатьПредупреждение(, НСтр("ru = \'Пока не работает\'"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Дом вещи всегда совпадает с домом её места.
&НаСервере
Процедура МестоПриИзмененииНаСервере()

	Если ЗначениеЗаполнено(Объект.Место) Тогда
		Объект.ОбъектНедвижимости = Объект.Место.Владелец;
	КонецЕсли;

КонецПроцедуры

// Помещает основное фото во временное хранилище для поля «Фото».
&НаСервере
Процедура ПоказатьФото()

	АдресФото = "";
	// T-016: получить данные через Вложения.Данные(Объект.ОсновноеФото).

КонецПроцедуры

#КонецОбласти
