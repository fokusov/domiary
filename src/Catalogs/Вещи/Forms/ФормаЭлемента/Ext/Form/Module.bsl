#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Новую вещь добавляют с одного поля, карточка называется «Новая вещь» (UX_MAP §3.4).
	Если Объект.Ссылка.Пустая() Тогда
		Заголовок = НСтр("ru = 'Новая вещь'");
	КонецЕсли;

	// В выборе места — только действующие места.
	ПараметрыВыбора = Новый Массив;
	ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Архив", Ложь));
	Элементы.Место.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура МестоПриИзменении(Элемент)

	МестоПриИзмененииНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Дом вещи всегда совпадает с домом её места.
&НаСервере
Процедура МестоПриИзмененииНаСервере()

	Если ЗначениеЗаполнено(Объект.Место) Тогда
		Объект.ОбъектНедвижимости = Объект.Место.Владелец;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
