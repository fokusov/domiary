// Вещь: предмет, которым владеете (METADATA §2.4).
// Место, дом и статус — текущие значения в самой вещи; их историю пишут события
// записи объекта в регистры МестонахождениеВещей и СтатусыВещейИстория (T-015).

Перем НоваяЗапись;               // признак новой записи между ПередЗаписью и ПриЗаписи
Перем ИзменилосьМестонахождение; // изменились ли место или дом относительно базы
Перем ИзменилсяСтатус;           // изменился ли статус относительно базы

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Статус = Перечисления.СтатусыВещей.Используется;
	Место = Вещи.ПоследнееМесто();
	Если Место.Пустая() Тогда
		ОбъектНедвижимости = Дома.ДомПоУмолчанию();
	Иначе
		ОбъектНедвижимости = Место.Владелец;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ПустаяСтрока(Наименование) Тогда
		Отказ = Истина;
		СообщитьПользователю(НСтр("ru = 'Укажите название — без него вещь не найти в поиске.'"),
			"Наименование");
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	НоваяЗапись = ЭтоНовый();

	Если НЕ ОбменДанными.Загрузка Тогда
		// Дом вещи всегда совпадает с домом её места.
		Если НЕ Место.Пустая() Тогда
			ОбъектНедвижимости = Место.Владелец;
		КонецЕсли;
		ЗапомнитьИзменения();
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если НЕ ОбменДанными.Загрузка Тогда
		Если ИзменилосьМестонахождение Тогда
			ЗаписатьМестонахождение();
		КонецЕсли;
		Если ИзменилсяСтатус Тогда
			ЗаписатьСтатус();
		КонецЕсли;
		Если НЕ Место.Пустая() Тогда
			Вещи.ЗапомнитьПоследнееМесто(Место);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сравнивает место, дом и статус с сохранёнными в базе. У новой вещи ссылка ещё
// пустая, поэтому изменением считается любое заполненное значение.
Процедура ЗапомнитьИзменения()

	Если НоваяЗапись Тогда
		ИзменилосьМестонахождение = НЕ Место.Пустая() ИЛИ НЕ ОбъектНедвижимости.Пустая();
		ИзменилсяСтатус = НЕ Статус.Пустая();
		Возврат;
	КонецЕсли;

	Сохранённые = СохранённыеЗначения();
	Если Сохранённые = Неопределено Тогда
		// Запись исчезла из базы между чтением и записью: историю не пишем.
		ИзменилосьМестонахождение = Ложь;
		ИзменилсяСтатус = Ложь;
	Иначе
		ИзменилосьМестонахождение = Сохранённые.Место <> Место
			ИЛИ Сохранённые.ОбъектНедвижимости <> ОбъектНедвижимости;
		ИзменилсяСтатус = Сохранённые.Статус <> Статус;
	КонецЕсли;

КонецПроцедуры

// Место, дом и статус существующей вещи по ссылке.
Функция СохранённыеЗначения()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Вещи.Место КАК Место,
	|	Вещи.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	Вещи.Статус КАК Статус
	|ИЗ
	|	Справочник.Вещи КАК Вещи
	|ГДЕ
	|	Вещи.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Место, ОбъектНедвижимости, Статус",
			Выборка.Место, Выборка.ОбъектНедвижимости, Выборка.Статус);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Добавляет запись истории местонахождения. Две записи одной вещи в одну секунду
// перезапишут друг друга — это допустимо (T-015).
Процедура ЗаписатьМестонахождение()

	Запись = РегистрыСведений.МестонахождениеВещей.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.Вещь = Ссылка;
	Запись.ОбъектНедвижимости = ОбъектНедвижимости;
	Запись.Место = Место;
	ЗаметкаИстории = Неопределено;
	Если ДополнительныеСвойства.Свойство("ЗаметкаИстории", ЗаметкаИстории) Тогда
		Запись.Заметка = ЗаметкаИстории;
	КонецЕсли;
	Запись.Записать(Истина);

КонецПроцедуры

// Добавляет запись истории статуса; перезапись в одну секунду — как у местонахождения.
Процедура ЗаписатьСтатус()

	Запись = РегистрыСведений.СтатусыВещейИстория.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.Вещь = Ссылка;
	Запись.Статус = Статус;
	ЗаметкаИстории = Неопределено;
	Если ДополнительныеСвойства.Свойство("ЗаметкаИстории", ЗаметкаИстории) Тогда
		Запись.Заметка = ЗаметкаИстории;
	КонецЕсли;
	Запись.Записать(Истина);

КонецПроцедуры

Процедура СообщитьПользователю(Текст, Поле = "")

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
