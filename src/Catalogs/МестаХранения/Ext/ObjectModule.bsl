// Место: помещение, зона, шкаф, полка внутри одного дома (METADATA §2.2).
// Дерево мест и принадлежность дому проверяет сервис Дома.

Перем ИзменилсяАрхив; // изменился ли признак «Архив» относительно базы

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ТипМеста.Пустая() Тогда
		ТипМеста = Перечисления.ТипыМест.Помещение;
	КонецЕсли;
	Если Владелец.Пустая() Тогда
		Владелец = Дома.ДомПоУмолчанию();
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	ИзменилсяАрхив = Дома.ИзменилсяАрхив(Ссылка, Архив);
	Дома.ПроверитьМесто(ЭтотОбъект, Отказ);

КонецПроцедуры

// Признак «Архив» уходит вложенным местам, дальше по дереву — их событиями.
Процедура ПриЗаписи(Отказ)

	Если ИзменилсяАрхив И НЕ ОбменДанными.Загрузка Тогда
		Дома.ЗаписатьАрхивВложеннымМестам(Ссылка, Архив);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ПустаяСтрока(Наименование) Тогда
		Отказ = Истина;
		СообщитьПользователю(НСтр("ru = 'Укажите название — без него место не найти в поиске.'"),
			"Наименование");
	КонецЕсли;

	Если Владелец.Пустая() Тогда
		Отказ = Истина;
		СообщитьПользователю(НСтр("ru = 'Выберите дом, в котором находится место.'"),
			"Владелец");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СообщитьПользователю(Текст, Поле = "")

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
