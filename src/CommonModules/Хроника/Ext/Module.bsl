// Общая история событий (ADR-003).
// Регистр Хроника — производные данные: источник истины — документы и справочники модулей.
// Пишет в регистр только этот модуль, в транзакции записи источника.

#Область ПрограммныйИнтерфейс

// Создаёт описание события для ДобавитьЗапись.
//
// Параметры:
//  ТипСобытия - ПеречислениеСсылка.ТипыСобытийХроники
//  Заголовок - Строка - текст для пользователя: «Заменили картридж фильтра».
//  Дата - Дата - по умолчанию текущая дата сеанса.
//
// Возвращаемое значение:
//  Структура:
//   * Дата - Дата
//   * ТипСобытия - ПеречислениеСсылка.ТипыСобытийХроники
//   * Заголовок - Строка
//   * Описание - Строка
//   * Сумма - Число
//   * Валюта - Строка
//
Функция НовоеСобытие(ТипСобытия, Заголовок, Дата = Неопределено) Экспорт

	Событие = Новый Структура;
	Событие.Вставить("Дата", ?(Дата = Неопределено, ТекущаяДатаСеанса(), Дата));
	Событие.Вставить("ТипСобытия", ТипСобытия);
	Событие.Вставить("Заголовок", Заголовок);
	Событие.Вставить("Описание", "");
	Событие.Вставить("Сумма", 0);
	Событие.Вставить("Валюта", "");
	Возврат Событие;

КонецФункции

// Добавляет событие в историю.
//
// Параметры:
//  Событие - см. НовоеСобытие
//
// Возвращаемое значение:
//  УникальныйИдентификатор - идентификатор записи.
//
Функция ДобавитьЗапись(Событие) Экспорт

	Запись = РегистрыСведений.Хроника.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Новый УникальныйИдентификатор;
	ЗаполнитьЗначенияСвойств(Запись, Событие);
	Запись.Записать();
	Возврат Запись.Идентификатор;

КонецФункции

// Удаляет все записи истории и строит их заново из источников.
// Вызывается после восстановления из резервной копии и после миграций, меняющих источники.
// Источники подключаются по мере появления модулей (Фаза 1 и далее): каждый модуль отдаёт
// свои события функцией СобытияДляХроники().
//
Процедура Перестроить() Экспорт

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("РегистрСведений.Хроника");
		Блокировка.Заблокировать();

		Набор = РегистрыСведений.Хроника.СоздатьНаборЗаписей();
		Набор.Записать();

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
