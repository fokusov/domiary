// Общая история событий (ADR-003).
// Регистр Хроника — производные данные: источник истины — документы и справочники модулей.
// Пишет в регистр только этот модуль, в транзакции записи источника.

#Область ПрограммныйИнтерфейс

// Создаёт описание события для ДобавитьЗапись.
//
// Параметры:
//  ТипСобытия - ПеречислениеСсылка.ТипыСобытийХроники
//  Заголовок - Строка - текст для пользователя: «Заменили картридж фильтра».
//  Дата - Дата - по умолчанию текущая дата сеанса.
//
// Возвращаемое значение:
//  Структура:
//   * Дата - Дата
//   * ТипСобытия - ПеречислениеСсылка.ТипыСобытийХроники
//   * Заголовок - Строка
//   * Описание - Строка
//   * Сумма - Число
//   * Валюта - Строка
//   * Объект - СправочникСсылка.Вещи, СправочникСсылка.ОбъектыНедвижимости,
//              СправочникСсылка.МестаХранения - Неопределено, если не задано
//   * ОбъектНедвижимости - СправочникСсылка.ОбъектыНедвижимости - Неопределено, если не задано
//   * Источник - СправочникСсылка.Вещи, СправочникСсылка.Вложения,
//                ДокументСсылка.ПокупкаВещи - Неопределено, если не задано
//
Функция НовоеСобытие(ТипСобытия, Заголовок, Дата = Неопределено) Экспорт

	Событие = Новый Структура;
	Событие.Вставить("Дата", ?(Дата = Неопределено, ТекущаяДатаСеанса(), Дата));
	Событие.Вставить("ТипСобытия", ТипСобытия);
	Событие.Вставить("Заголовок", Заголовок);
	Событие.Вставить("Описание", "");
	Событие.Вставить("Сумма", 0);
	Событие.Вставить("Валюта", "");
	Событие.Вставить("Объект", Неопределено);
	Событие.Вставить("ОбъектНедвижимости", Неопределено);
	Событие.Вставить("Источник", Неопределено);
	Возврат Событие;

КонецФункции

// Добавляет событие в историю.
//
// Параметры:
//  Событие - см. НовоеСобытие
//
// Возвращаемое значение:
//  УникальныйИдентификатор - идентификатор записи.
//
Функция ДобавитьЗапись(Событие) Экспорт

	Запись = РегистрыСведений.Хроника.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Новый УникальныйИдентификатор;
	ЗаполнитьЗначенияСвойств(Запись, Событие);
	Запись.Записать();
	Возврат Запись.Идентификатор;

КонецФункции

// Заменяет все события одного источника: удаляет его записи и пишет переданные.
// События строит та же функция источника, что и СобытияДляХроники, — перестроенная
// история совпадает с накопленной (ADR-003).
//
// Параметры:
//  Источник - СправочникСсылка.Вещи, СправочникСсылка.Вложения, ДокументСсылка.ПокупкаВещи
//  События  - Массив структур, см. НовоеСобытие
//
Процедура ОбновитьПоИсточнику(Источник, События) Экспорт

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьХронику();
		УдалитьЗаписиИсточника(Источник);
		Для Каждого Событие Из События Цикл
			Событие.Источник = Источник;
			ДобавитьЗапись(Событие);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Удаляет все события одного источника.
//
// Параметры:
//  Источник - СправочникСсылка.Вещи, СправочникСсылка.Вложения, ДокументСсылка.ПокупкаВещи
//
Процедура УдалитьПоИсточнику(Источник) Экспорт

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьХронику();
		УдалитьЗаписиИсточника(Источник);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Удаляет все записи истории и строит их заново из источников.
// Вызывается после восстановления из резервной копии и после миграций, меняющих источники.
// Источники подключаются по мере появления модулей: каждый модуль отдаёт
// свои события функцией СобытияДляХроники().
//
Процедура Перестроить() Экспорт

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьХронику();

		Набор = РегистрыСведений.Хроника.СоздатьНаборЗаписей();
		Набор.Записать();

		ЗаписатьСобытия(Вещи.СобытияДляХроники());
		ЗаписатьСобытия(Вложения.СобытияДляХроники());

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пишет массив событий, созданных НовоеСобытие.
Процедура ЗаписатьСобытия(События)

	Для Каждого Событие Из События Цикл
		ДобавитьЗапись(Событие);
	КонецЦикла;

КонецПроцедуры

// Удаляет записи истории по источнику: идентификаторы читаются запросом
// по индексу Источник, удаление — менеджером записи по измерению Идентификатор.
Процедура УдалитьЗаписиИсточника(Источник)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Хроника.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.Хроника КАК Хроника
	|ГДЕ
	|	Хроника.Источник = &Источник";
	Запрос.УстановитьПараметр("Источник", Источник);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.Хроника.СоздатьМенеджерЗаписи();
		Запись.Идентификатор = Выборка.Идентификатор;
		Запись.Удалить();
	КонецЦикла;

КонецПроцедуры

// Управляемая исключительная блокировка всего регистра: историю пишет только этот модуль.
Процедура ЗаблокироватьХронику()

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.Хроника");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

#КонецОбласти
