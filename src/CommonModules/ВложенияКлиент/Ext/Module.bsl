// Клиентская часть работы с файлами (T-016): камера, выбор файла, сканирование
// и открытие файла устройством. Модальность не используется: вместо Предупреждение —
// ПоказатьПредупреждение, долгие операции — Асинх/Ждать. Проверенные приёмы —
// spike T-001. Двоичные данные передаются на сервер через временное хранилище,
// а не параметром вызова.

#Область ПрограммныйИнтерфейс

// Снимает фото камерой устройства: качество 70 и до 1600 пикселей по длинной
// стороне (ADR-002).
//
// Возвращаемое значение:
//  ДвоичныеДанные - снимок; Неопределено — если камеры нет (сообщение уже
//                   показано) или съёмка отменена
//
Функция СнятьФото() Экспорт

#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда
	Если НЕ СредстваМультимедиа.ПоддерживаетсяФотоснимок() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Камера на этом устройстве не поддерживается.'"));
		Возврат Неопределено;
	КонецЕсли;

	// Разрешение — объект РазрешениеКамерыУстройства, не число; если устройство
	// не примет размер, снимаем с разрешением по умолчанию.
	Попытка
		Разрешение = Новый РазрешениеКамерыУстройства(1600, 1200);
	Исключение
		Разрешение = Неопределено;
	КонецПопытки;
	Снимок = СредстваМультимедиа.СделатьФотоснимок(, Разрешение, 70);
	Если Снимок = Неопределено Тогда
		Возврат Неопределено; // съёмка отменена — тихо выходим
	КонецЕсли;
	Возврат Снимок.ПолучитьДвоичныеДанные();
#Иначе
	ПоказатьПредупреждение(, НСтр("ru = 'Камера доступна только на телефоне.'"));
	Возврат Неопределено;
#КонецЕсли

КонецФункции

// Открывает выбор файла на устройстве и помещает выбранный файл на сервер
// во временное хранилище.
//
// Параметры:
//  ИдентификаторФормы - УникальныйИдентификатор - форма, в контексте которой
//                       живёт временное хранилище
//
// Возвращаемое значение:
//  Структура:
//   * Адрес - Строка - адрес файла во временном хранилище
//   * Имя   - Строка - имя выбранного файла
//  Неопределено — если выбор отменён или не открылся (сообщение уже показано)
//
Асинх Функция ВыбратьФайл(ИдентификаторФормы) Экспорт

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Выберите файл'");

	Попытка
		Описание = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыДиалога, ИдентификаторФормы);
	Исключение
		ПоказатьПредупреждение(, НСтр("ru = 'Не получилось открыть выбор файла. Попробуйте ещё раз.'"));
		Возврат Неопределено;
	КонецПопытки;

	Если Описание = Неопределено Тогда
		Возврат Неопределено; // выбор отменён — тихо выходим
	КонецЕсли;
	Если Описание.ПомещениеФайлаОтменено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Адрес, Имя", Описание.Адрес, Описание.СсылкаНаФайл.Имя);

КонецФункции

// Сканирует документы камерой: каждая страница — отдельное изображение.
//
// Возвращаемое значение:
//  Массив из ДвоичныеДанные - страницы скана; пустой массив — если сканирование
//  не поддерживается (сообщение уже показано) или отменено
//
Асинх Функция Отсканировать() Экспорт

	СтраницыДанных = Новый Массив;

#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда
	Если НЕ СредстваМультимедиа.ПоддерживаетсяСканированиеДокументов() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сканирование доступно только на телефоне.'"));
		Возврат СтраницыДанных;
	КонецЕсли;

	Страницы = Ждать СредстваМультимедиа.СканироватьДокументыАсинх(НСтр("ru = 'Сканирование документа'"));
	Если Страницы = Неопределено Тогда
		Возврат СтраницыДанных; // сканирование отменено — тихо выходим
	КонецЕсли;

	Для Каждого Страница Из Страницы Цикл
		Данные = Страница.ДанныеИзображения;
		Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
			Данные = Данные.ПолучитьДвоичныеДанные();
		КонецЕсли;
		СтраницыДанных.Добавить(Данные);
	КонецЦикла;
#Иначе
	ПоказатьПредупреждение(, НСтр("ru = 'Сканирование доступно только на телефоне.'"));
#КонецЕсли

	Возврат СтраницыДанных;

КонецФункции

// Сохраняет файл как документ вещи или дома: помещает данные во временное
// хранилище и вызывает сервер.
//
// Параметры:
//  ИдентификаторФормы - УникальныйИдентификатор
//  Предмет            - СправочникСсылка.Вещи, СправочникСсылка.ОбъектыНедвижимости
//  Данные             - ДвоичныеДанные - содержимое файла
//  ИмяФайла           - Строка - имя файла, например «Фото 02.10.2026.jpg»
//  ТипДокумента       - ПеречислениеСсылка.ТипыДокументов - необязательно
//
// Возвращаемое значение:
//  СправочникСсылка.Вложения
//
Функция ДобавитьФайл(ИдентификаторФормы, Предмет, Данные, ИмяФайла, ТипДокумента = Неопределено) Экспорт

	Адрес = ПоместитьВоВременноеХранилище(Данные, ИдентификаторФормы);
	Возврат Вложения.ДобавитьИзХранилища(Предмет, Адрес, ИмяФайла, ТипДокумента);

КонецФункции

// Сохраняет снимок камеры как основное фото вещи.
//
// Параметры:
//  ИдентификаторФормы - УникальныйИдентификатор
//  Вещь               - СправочникСсылка.Вещи - уже сохранённая вещь
//  Данные             - ДвоичныеДанные - снимок камеры
//  ИмяФайла           - Строка - имя файла, например «Фото 02.10.2026.jpg»
//
// Возвращаемое значение:
//  СправочникСсылка.Вложения
//
Функция УстановитьФото(ИдентификаторФормы, Вещь, Данные, ИмяФайла) Экспорт

	Адрес = ПоместитьВоВременноеХранилище(Данные, ИдентификаторФормы);
	Возврат Вложения.УстановитьОсновноеФотоИзХранилища(Вещь, Адрес, ИмяФайла);

КонецФункции

// Сохраняет файл документа на устройство во временный файл и открывает его
// системным приложением.
//
// Параметры:
//  Вложение           - СправочникСсылка.Вложения
//  ИмяФайла           - Строка - имя файла с расширением; расширение нужно,
//                       чтобы устройство подобрало приложение
//  ИдентификаторФормы - УникальныйИдентификатор
//
Процедура ОткрытьФайл(Вложение, ИмяФайла, ИдентификаторФормы) Экспорт

	Адрес = Вложения.ПоместитьФайл(Вложение, ИдентификаторФормы);
	Если Адрес = "" Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'У документа нет файла. Попробуйте добавить его ещё раз.'"));
		Возврат;
	КонецЕсли;

	ИмяНаУстройстве = ИмяФайла;
	Если ПустаяСтрока(ИмяНаУстройстве) Тогда
		ИмяНаУстройстве = "файл";
	КонецЕсли;

	ПолноеИмя = КаталогВременныхФайлов() + ИмяНаУстройстве;
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	Данные.Записать(ПолноеИмя);

	Попытка
		ЗапуститьПриложение(ПолноеИмя);
	Исключение
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Файл не удалось открыть. Проверьте, что на устройстве есть приложение для таких файлов.'"));
	КонецПопытки;

КонецПроцедуры

// Имя файла для снимка камеры: «Фото 02.10.2026.jpg». Из имени без расширения
// получается наименование документа (см. Вложения.Добавить).
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяСнимка() Экспорт

	Возврат "Фото " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ".jpg";

КонецФункции

// Имя файла для страницы скана: «Скан 02.10.2026.jpg», страницы со второй
// получают номер: «Скан 02.10.2026 2.jpg».
//
// Параметры:
//  Номер - Число - номер страницы, начиная с 1
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяСканаСтраницы(Номер) Экспорт

	Имя = "Скан " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy");
	Если Номер > 1 Тогда
		Имя = Имя + " " + Номер;
	КонецЕсли;
	Возврат Имя + ".jpg";

КонецФункции

#КонецОбласти
