// Сервис домов и мест (ARCHITECTURE §4, модуль Home): дом по умолчанию,
// архивирование вместо удаления, контроль дерева мест внутри одного дома.
// Тексты, видимые пользователю, — только по словарю (docs/GLOSSARY.md).

#Область ПрограммныйИнтерфейс

// Возвращает дом по умолчанию для новых записей:
//  1) дом, выбранный последним (ключ «ПоследнийДом»), если он ещё активен;
//  2) иначе первый активный дом по наименованию (единственный активный дом — он же).
//
// Возвращаемое значение:
//  СправочникСсылка.ОбъектыНедвижимости - пустая ссылка, если активных домов нет.
//
Функция ДомПоУмолчанию() Экспорт

	Дом = ПоследнийДом();
	Если Дом.Пустая() Тогда
		Дом = ПервыйАктивныйДом();
	КонецЕсли;
	Возврат Дом;

КонецФункции

// Возвращает количество домов.
//
// Параметры:
//  ВключаяАрхив - Булево - учитывать дома из архива.
//
// Возвращаемое значение:
//  Число
//
Функция КоличествоДомов(Знач ВключаяАрхив = Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Справочник.ОбъектыНедвижимости КАК ОбъектыНедвижимости
	|ГДЕ
	|	НЕ ОбъектыНедвижимости.ПометкаУдаления";
	Если НЕ ВключаяАрхив Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И НЕ ОбъектыНедвижимости.Архив";
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;

КонецФункции

// Запоминает дом как выбранный последним (ключ «ПоследнийДом»).
//
// Параметры:
//  Дом - СправочникСсылка.ОбъектыНедвижимости
//
Процедура ЗапомнитьПоследнийДом(Дом) Экспорт

	Если Дом.Пустая() Тогда
		Возврат;
	КонецЕсли;
	Запись = РегистрыСведений.СостояниеПриложения.СоздатьМенеджерЗаписи();
	Запись.Ключ = КлючПоследнегоДома();
	Запись.Значение = Строка(Дом.УникальныйИдентификатор());
	Запись.Записать(Истина);

КонецПроцедуры

// Переносит дом или место в архив (и обратно) вместе со всеми вложенными местами:
// у дома — все его места, у места — всё поддерево. Одна транзакция,
// управляемая блокировка по дому (std648).
//
// Параметры:
//  Ссылка - СправочникСсылка.ОбъектыНедвижимости, СправочникСсылка.МестаХранения
//  Архив  - Булево
//
Процедура УстановитьАрхив(Ссылка, Архив) Экспорт

	ЭтоДом = ТипЗнч(Ссылка) = Тип("СправочникСсылка.ОбъектыНедвижимости");
	ЭтоМесто = ТипЗнч(Ссылка) = Тип("СправочникСсылка.МестаХранения");
	Если (НЕ ЭтоДом И НЕ ЭтоМесто) ИЛИ Ссылка.Пустая() Тогда
		ВызватьИсключение НСтр("ru = 'Архив можно включить и выключить только у дома или места.'");
	КонецЕсли;

	Если ЭтоДом Тогда
		Дом = Ссылка;
	Иначе
		Сведения = СведенияОМесте(Ссылка);
		Если Сведения = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Это место уже не существует. Обновите список и попробуйте ещё раз.'");
		КонецЕсли;
		Дом = Сведения.Владелец;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьДомИМеста(Дом);

		Если ЭтоДом Тогда
			Места = МестаДома(Дом);
		Иначе
			Места = ПоддеревоМеста(Ссылка, Дом);
		КонецЕсли;
		ЗаписатьАрхив(Ссылка, Архив);
		Для Каждого Место Из Места Цикл
			ЗаписатьАрхив(Место, Архив);
		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		// Журнала регистрации на мобильном приложении нет: причина уходит в текст ошибки.
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось изменить архив: %1'"),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Проверяет место перед записью: родитель принадлежит тому же дому,
// место не входит в само себя и в свои вложенные места (нет циклов).
// При нарушении добавляет сообщение по словарю и устанавливает Отказ.
//
// Параметры:
//  МестоОбъект - СправочникОбъект.МестаХранения
//  Отказ       - Булево
//
Процедура ПроверитьМесто(МестоОбъект, Отказ) Экспорт

	Если МестоОбъект.Родитель.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Если МестоОбъект.Родитель = МестоОбъект.Ссылка Тогда
		Отказ = Истина;
		СообщитьПользователю(НСтр("ru = 'Место не может входить в само себя. Выберите другое место или оставьте поле пустым.'"),
			"Родитель");
		Возврат;
	КонецЕсли;

	СведенияРодителя = СведенияОМесте(МестоОбъект.Родитель);
	Если СведенияРодителя <> Неопределено И СведенияРодителя.Владелец <> МестоОбъект.Владелец Тогда
		Отказ = Истина;
		СообщитьПользователю(СтрШаблон(НСтр("ru = 'Место «%1» относится к другому дому. Выберите место из того же дома.'"),
			Строка(МестоОбъект.Родитель)), "Родитель");
		Возврат;
	КонецЕсли;

	Если МестоОбразуетЦикл(МестоОбъект.Ссылка, МестоОбъект.Родитель) Тогда
		Отказ = Истина;
		СообщитьПользователю(НСтр("ru = 'Место не может входить в свои вложенные места. Выберите место выше по дереву или оставьте поле пустым.'"),
			"Родитель");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Дом, выбранный последним, если он существует и не в архиве.
Функция ПоследнийДом()

	Идентификатор = Миграции.ЗначениеСостояния(КлючПоследнегоДома());
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Справочники.ОбъектыНедвижимости.ПустаяСсылка();
	КонецЕсли;

	Попытка
		Дом = Справочники.ОбъектыНедвижимости.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	Исключение
		// Повреждённое значение (например, после восстановления копии): считаем, что выбора не было.
		Возврат Справочники.ОбъектыНедвижимости.ПустаяСсылка();
	КонецПопытки;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОбъектыНедвижимости.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОбъектыНедвижимости КАК ОбъектыНедвижимости
	|ГДЕ
	|	ОбъектыНедвижимости.Ссылка = &Ссылка
	|	И НЕ ОбъектыНедвижимости.ПометкаУдаления
	|	И НЕ ОбъектыНедвижимости.Архив";
	Запрос.УстановитьПараметр("Ссылка", Дом);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ОбъектыНедвижимости.ПустаяСсылка();

КонецФункции

// Первый активный дом по наименованию.
Функция ПервыйАктивныйДом()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОбъектыНедвижимости.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОбъектыНедвижимости КАК ОбъектыНедвижимости
	|ГДЕ
	|	НЕ ОбъектыНедвижимости.ПометкаУдаления
	|	И НЕ ОбъектыНедвижимости.Архив
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектыНедвижимости.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ОбъектыНедвижимости.ПустаяСсылка();

КонецФункции

// Возвращает родителя и дом места; Неопределено, если места нет.
Функция СведенияОМесте(Место)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МестаХранения.Родитель КАК Родитель,
	|	МестаХранения.Владелец КАК Владелец
	|ИЗ
	|	Справочник.МестаХранения КАК МестаХранения
	|ГДЕ
	|	МестаХранения.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Место);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Родитель, Владелец", Выборка.Родитель, Выборка.Владелец);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Все места дома (без помеченных на удаление): Ссылка и Родитель.
Функция МестаДома(Дом)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МестаХранения.Ссылка КАК Ссылка,
	|	МестаХранения.Родитель КАК Родитель
	|ИЗ
	|	Справочник.МестаХранения КАК МестаХранения
	|ГДЕ
	|	МестаХранения.Владелец = &Владелец
	|	И НЕ МестаХранения.ПометкаУдаления";
	Запрос.УстановитьПараметр("Владелец", Дом);

	Места = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Места.Добавить(Новый Структура("Ссылка, Родитель", Выборка.Ссылка, Выборка.Родитель));
	КонецЦикла;
	Возврат Места;

КонецФункции

// Поддерево места (включая само место) в пределах дома.
Функция ПоддеревоМеста(Место, Дом)

	ДетиПоРодителю = Новый Соответствие;
	Для Каждого Узел Из МестаДома(Дом) Цикл
		Дети = ДетиПоРодителю[Узел.Родитель];
		Если Дети = Неопределено Тогда
			Дети = Новый Массив;
			ДетиПоРодителю.Вставить(Узел.Родитель, Дети);
		КонецЕсли;
		Дети.Добавить(Узел.Ссылка);
	КонецЦикла;

	Поддерево = Новый Массив;
	Очередь = Новый Массив;
	Очередь.Добавить(Место);
	Индекс = 0;
	Пока Индекс < Очередь.Количество() Цикл
		Текущее = Очередь[Индекс];
		Поддерево.Добавить(Текущее);
		Дети = ДетиПоРодителю[Текущее];
		Если Дети <> Неопределено Тогда
			Для Каждого Ребенок Из Дети Цикл
				// Защита от повреждённых данных с циклом в дереве.
				Если Поддерево.Найти(Ребенок) = Неопределено Тогда
					Очередь.Добавить(Ребенок);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Поддерево;

КонецФункции

// Проверяет, встретится ли записываемое место при подъёме от родителя вверх по дереву.
Функция МестоОбразуетЦикл(Ссылка, Родитель)

	Пройденные = Новый Соответствие;
	ТекущийРодитель = Родитель;
	Пока НЕ ТекущийРодитель.Пустая() Цикл
		Если ТекущийРодитель = Ссылка Тогда
			Возврат Истина;
		КонецЕсли;
		Если Пройденные[ТекущийРодитель] <> Неопределено Тогда
			// Уже существующий в данных цикл, не связанный с записываемым местом.
			Возврат Ложь;
		КонецЕсли;
		Пройденные.Вставить(ТекущийРодитель, Истина);
		Сведения = СведенияОМесте(ТекущийРодитель);
		Если Сведения = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		ТекущийРодитель = Сведения.Родитель;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Исключительная блокировка дома и всех его мест (std648).
Процедура ЗаблокироватьДомИМеста(Дом)

	Блокировка = Новый БлокировкаДанных;
	ЭлементДома = Блокировка.Добавить("Справочник.ОбъектыНедвижимости");
	ЭлементДома.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементДома.УстановитьЗначение("Ссылка", Дом);
	ЭлементМест = Блокировка.Добавить("Справочник.МестаХранения");
	ЭлементМест.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементМест.УстановитьЗначение("Владелец", Дом);
	Блокировка.Заблокировать();

КонецПроцедуры

// Записывает признак архива у дома или места, если он изменился.
Процедура ЗаписатьАрхив(Ссылка, Архив)

	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено ИЛИ Объект.Архив = Архив Тогда
		Возврат;
	КонецЕсли;
	Объект.Архив = Архив;
	Объект.Записать();

КонецПроцедуры

Процедура СообщитьПользователю(Текст, Поле = "")

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.Сообщить();

КонецПроцедуры

Функция КлючПоследнегоДома()

	Возврат "ПоследнийДом";

КонецФункции

#КонецОбласти
