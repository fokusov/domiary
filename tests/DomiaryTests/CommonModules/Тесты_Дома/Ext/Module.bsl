Процедура ПроверитьАрхивДомаСДеревом(Архив)

	Дом = СоздатьДом("Дом дерева");
	Корень = СоздатьМесто(Дом, "Кухня");
	Дочернее = СоздатьМесто(Дом, "Шкаф", Корень);
	Внук = СоздатьМесто(Дом, "Полка", Дочернее);
	Соседнее = СоздатьМесто(Дом, "Гараж");
	ДругойДом = СоздатьДом("Другой дом");
	Чужое = СоздатьМесто(ДругойДом, "Чужое место");
	ЗадатьАрхивФикстуры(Дом, НЕ Архив);
	ЗадатьАрхивФикстуры(Корень, НЕ Архив);
	ЗадатьАрхивФикстуры(Дочернее, НЕ Архив);
	ЗадатьАрхивФикстуры(Внук, НЕ Архив);
	ЗадатьАрхивФикстуры(Соседнее, НЕ Архив);
	Дома.УстановитьАрхив(Дом, Архив);
	ПроверитьАрхив(Дом, Архив);
	ПроверитьАрхив(Корень, Архив);
	ПроверитьАрхив(Дочернее, Архив);
	ПроверитьАрхив(Внук, Архив);
	ПроверитьАрхив(Соседнее, Архив);
	ПроверитьАрхив(ДругойДом, Ложь);
	ПроверитьАрхив(Чужое, Ложь);

КонецПроцедуры

