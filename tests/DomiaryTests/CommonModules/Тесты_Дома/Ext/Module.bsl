Процедура ИсполняемыеСценарии() Экспорт

	Для Каждого ИмяТеста Из СтрРазделить(
		"ДомПоУмолчаниюНетДомов,ДомПоУмолчаниюОдин,ДомПоУмолчаниюПоследний,"
		+ "ДомПоУмолчаниюАрхивныйПоследний,ДомПоУмолчаниюПоНаименованию,"
		+ "КоличествоДомов,АрхивДомаСДеревом,АрхивМестаСПоддеревом,"
		+ "ВосстановлениеДомаСДеревом,ВосстановлениеМестаСПоддеревом,"
		+ "МестоЧужогоДома,МестоСамоВСебя,МестоОбразуетЦикл,КорректноеМесто,"
		+ "ЗапретУдаленияДомаСМестами,ЗапретУдаленияДомаСАрхивнымиМестами,"
		+ "ЗапретУдаленияДомаСПомеченнымиМестами,СменаДомаМестаСДетьми", ",") Цикл
		// YAxUnit откатывает и созданные объекты, и ключ ПоследнийДом, даже при падении.
		ЮТТесты.ДобавитьТест(ИмяТеста).ВТранзакции().Перед("ПроверитьИзоляцию");
	КонецЦикла;
	ЮТТесты.ДобавитьТест("КонтрольОчистки");

КонецПроцедуры

Процедура ПроверитьИзоляцию() Экспорт

	// Не удаляем чужие данные: эти сценарии требуют пустого временного хозяйства.
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.ОбъектыНедвижимости");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ЮТест.ОжидаетЧто(Выборка.Количество).Равно(0);
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.МестаХранения";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ЮТест.ОжидаетЧто(Выборка.Количество).Равно(0);

КонецПроцедуры

Процедура КонтрольОчистки() Экспорт

	// Отдельное чтение вне транзакции проверяет, что фикстуры не остались в базе.
	ПроверитьИзоляцию();

