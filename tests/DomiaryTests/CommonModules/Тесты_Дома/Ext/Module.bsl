Процедура ЗадатьАрхивФикстуры(Ссылка, Архив)

	// Подготовка не вызывает проверяемый сервис: его дефект не маскирует другие тесты.
	Объект = Ссылка.ПолучитьОбъект();
	Объект.Архив = Архив;
	Объект.Записать();

КонецПроцедуры

Функция СоздатьДом(Название)

	Дом = Справочники.ОбъектыНедвижимости.СоздатьЭлемент();
	Дом.Наименование = Название;
	Дом.Тип = Перечисления.ТипыОбъектовНедвижимости.Квартира;
	Дом.Записать();
	Возврат Дом.Ссылка;

КонецФункции

Функция СоздатьМесто(Дом, Название, Родитель = Неопределено)

	Место = Справочники.МестаХранения.СоздатьЭлемент();
	Место.Наименование = Название;
	Место.Владелец = Дом;
	Место.ТипМеста = Перечисления.ТипыМест.Помещение;
	Если Родитель <> Неопределено Тогда
		Место.Родитель = Родитель;
	КонецЕсли;
	Место.Записать();
	Возврат Место.Ссылка;

КонецФункции

Процедура ОчиститьПоследнийДом()

	Запись = РегистрыСведений.СостояниеПриложения.СоздатьМенеджерЗаписи();
	Запись.Ключ = "ПоследнийДом";
	Запись.Значение = "";
	Запись.Записать(Истина);

КонецПроцедуры

Процедура ПроверитьАрхив(Ссылка, Архив)

	// Читаем объект заново, а не кеш реквизитов ссылки после предыдущего шага.
	ЮТест.ОжидаетЧто(Ссылка.ПолучитьОбъект().Архив).Равно(Архив);

КонецПроцедуры

Процедура ПроверитьОтказМеста(Место)

	Отказ = Ложь;
	Дома.ПроверитьМесто(Место, Отказ);
	ЮТест.ОжидаетЧто(Отказ).Равно(Истина);

КонецПроцедуры

Процедура ПроверитьЗапретУдаления(Дом)

	ОшибкаПолучена = Ложь;
	Попытка
		Дом.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
	Исключение
		ОшибкаПолучена = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ОшибкаПолучена).Равно(Истина);
	// После отказа записи транзакция непригодна для запросов; откат выполняет YAxUnit.

КонецПроцедуры
