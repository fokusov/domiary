	СледующаяСекунда();
	Вещи.ПереместитьВещь(Вещь, СоздатьМесто(СоздатьДом(), "Гараж"));
	// Не предписываем исторический или текущий дом: проверяем равенство проекций.
	ПроверитьПерестроение();

КонецПроцедуры

Процедура МиграцииПовторныйЗапуск() Экспорт

	// Версия устанавливается публичной миграцией при запуске чистой базы runner.
