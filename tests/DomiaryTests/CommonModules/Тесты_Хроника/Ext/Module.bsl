Функция СоздатьДом()

	Объект = Справочники.ОбъектыНедвижимости.СоздатьЭлемент();
	Объект.Наименование = "Дом теста хроники";
	Объект.Тип = Перечисления.ТипыОбъектовНедвижимости.Квартира;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция СоздатьМесто(Дом, Название)

	Объект = Справочники.МестаХранения.СоздатьЭлемент();
	Объект.Наименование = Название;
	Объект.Владелец = Дом;
	Объект.ТипМеста = Перечисления.ТипыМест.Помещение;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция НоваяВещь(Дом)

	Объект = Справочники.Вещи.СоздатьЭлемент();
	Объект.Наименование = "Дрель теста хроники";
	Объект.ОбъектНедвижимости = Дом;
	Объект.Статус = Перечисления.СтатусыВещей.Используется;
	Возврат Объект;

КонецФункции

Функция СоздатьВещь(Дом)

	Объект = НоваяВещь(Дом);
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция СоздатьПокупку(Дом, Место = Неопределено)

	Объект = НоваяВещь(Дом);
	Если Место <> Неопределено Тогда
		Объект.Место = Место;
	КонецЕсли;
	Объект.ДатаПокупки = Дата(2024, 1, 31);
	Объект.ЦенаПокупки = 100;
	Объект.Валюта = "RUB";
	Объект.Продавец = "Магазин";
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция ПрочитатьПокупки(Вещь)

	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Дата, Вещь, Сумма, Валюта, Продавец"
		+ " ИЗ Документ.ПокупкаВещи ГДЕ Вещь = &Вещь И НЕ ПометкаУдаления");
	Запрос.УстановитьПараметр("Вещь", Вещь);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ЕдинственнаяПокупка(Вещь)

	Покупки = ПрочитатьПокупки(Вещь);
	ЮТест.ОжидаетЧто(Покупки.Количество()).Равно(1);
	Возврат Покупки[0];

КонецФункции

Функция ПрочитатьХронику(Источник = Неопределено)

	Запрос = Новый Запрос("ВЫБРАТЬ Дата, ТипСобытия, Объект, ОбъектНедвижимости,"
		+ " Источник, Заголовок, Описание, Сумма, Валюта ИЗ РегистрСведений.Хроника"
		+ ?(Источник = Неопределено, "", " ГДЕ Источник = &Источник"));
	Запрос.УстановитьПараметр("Источник", Источник);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ЕдинственноеСобытие(Источник)

	События = ПрочитатьХронику(Источник);
	ЮТест.ОжидаетЧто(События.Количество()).Равно(1);
	Возврат События[0];

КонецФункции

Функция СобытиеФикстуры(Вещь, Дом, Заголовок)

	// Только три общих параметра; новые поля задаются в возвращённой структуре.
	Событие = Хроника.НовоеСобытие(Перечисления.ТипыСобытийХроники.Покупка, Заголовок, Дата(2024, 5, 6));
	Событие.Объект = Вещь;
	Событие.ОбъектНедвижимости = Дом;
	Событие.Источник = Вещь;
	Возврат Событие;

КонецФункции

Процедура ПроверитьПокупку(Покупка, ДатаПокупки, Сумма, Валюта, Продавец)

	ЮТест.ОжидаетЧто(Покупка.Дата).Равно(ДатаПокупки);
	ЮТест.ОжидаетЧто(Покупка.Сумма).Равно(Сумма);
	ЮТест.ОжидаетЧто(Покупка.Валюта).Равно(Валюта);
	ЮТест.ОжидаетЧто(Покупка.Продавец).Равно(Продавец);

КонецПроцедуры

Процедура ПроверитьСобытиеПокупки(Покупка, Вещь, Дом)

	Событие = ЕдинственноеСобытие(Покупка.Ссылка);
	ПроверитьЗаголовок(Покупка.Ссылка, "Купили", Перечисления.ТипыСобытийХроники.Покупка, Вещь, Дом);
	ЮТест.ОжидаетЧто(Покупка.Вещь).Равно(Вещь);
	ЮТест.ОжидаетЧто(Событие.Дата).Равно(Покупка.Дата);
	ЮТест.ОжидаетЧто(Событие.Сумма).Равно(Покупка.Сумма);
	ЮТест.ОжидаетЧто(Событие.Валюта).Равно(Покупка.Валюта);
	ЮТест.ОжидаетЧто(Событие.Описание).Равно(Покупка.Продавец);

КонецПроцедуры

Процедура ПроверитьЗаголовок(Источник, Заголовок, ТипСобытия, Объект, Дом)

	Строки = ПрочитатьХронику(Источник).НайтиСтроки(Новый Структура("Заголовок", Заголовок));
	ЮТест.ОжидаетЧто(Строки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Строки[0].ТипСобытия).Равно(ТипСобытия);
	ЮТест.ОжидаетЧто(Строки[0].Объект).Равно(Объект);
	ЮТест.ОжидаетЧто(Строки[0].ОбъектНедвижимости).Равно(Дом);
	ЮТест.ОжидаетЧто(Строки[0].Источник).Равно(Источник);

КонецПроцедуры

Процедура ПроверитьСобытие(Фактическое, Ожидаемое)

	Для Каждого Поле Из СтрРазделить("Дата,ТипСобытия,Объект,ОбъектНедвижимости,Источник,Заголовок,Описание,Сумма,Валюта", ",") Цикл
		ЮТест.ОжидаетЧто(Фактическое[Поле]).Равно(Ожидаемое[Поле]);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНаборы(Ожидаемые, Фактические)

	ЮТест.ОжидаетЧто(Фактические.Количество()).Равно(Ожидаемые.Количество());
	Остаток = Фактические.Скопировать();
	Для Каждого Событие Из Ожидаемые Цикл
		Отбор = Новый Структура;
		Для Каждого Колонка Из Ожидаемые.Колонки Цикл
			Отбор.Вставить(Колонка.Имя, Событие[Колонка.Имя]);
		КонецЦикла;
		Совпадения = Остаток.НайтиСтроки(Отбор);
		ЮТест.ОжидаетЧто(Совпадения.Количество() > 0).Равно(Истина);
		// Сравнение мультимножеств: дубли не теряются, порядок и UUID не учитываются.
		Остаток.Удалить(Совпадения[0]);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПерестроение()

	До = ПрочитатьХронику();
	Хроника.Перестроить();
	ПроверитьНаборы(До, ПрочитатьХронику());
	Хроника.Перестроить();
	ПроверитьНаборы(До, ПрочитатьХронику());

КонецПроцедуры

Процедура СледующаяСекунда()

	// T-015 допускает замещение истории в одну секунду. Не пишем регистры фикстурами:
	// разделяем публичные действия по времени без зависимости от внутренних методов.
	Сейчас = ТекущаяДатаСеанса();
	Пока ТекущаяДатаСеанса() <= Сейчас Цикл
	КонецЦикла;

КонецПроцедуры
