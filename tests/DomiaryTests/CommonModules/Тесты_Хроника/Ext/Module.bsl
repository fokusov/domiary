// Общий контракт T-017: только публичные операции и чтение результатов запросом.
Процедура ИсполняемыеСценарии() Экспорт

	Для Каждого ИмяТеста Из СтрРазделить(
		"НовоеСобытиеСовместимость,ДобавлениеЗаписи,ЗаменаСобытийИсточника,УдалениеСобытийИсточника,"
		+ "ПокупкаСоздание,ПокупкаОбновление,ПокупкаБезИзменений,ПокупкаОчисткаИПовторноеСоздание,"
		+ "ПокупкаПоОдномуПолю,ВалютаБезПокупки,ГарантияАвтоматическая,ГарантияРучная,"
		+ "ГарантияГраницы,Перемещения,Статусы,ДокументыИФото,ДокументыДомаИПокупки,"
		+ "УдалениеДокумента,ПерестроениеПослеДействий,ПерестроениеПослеСменыДома,"
		+ "ПерестроениеПослеОчисткиПокупкиСЧеком,МиграцииПовторныйЗапуск", ",") Цикл
		ЮТТесты.ДобавитьТест(ИмяТеста).ВТранзакции().Перед("ПроверитьИзоляцию");
	КонецЦикла;
	ЮТТесты.ДобавитьТест("КонтрольОчистки");

КонецПроцедуры

Процедура НовоеСобытиеСовместимость() Экспорт

	До = ТекущаяДатаСеанса();
	Событие = Хроника.НовоеСобытие(Перечисления.ТипыСобытийХроники.Покупка, "Купили");
	ЮТест.ОжидаетЧто(Событие.Дата >= До И Событие.Дата <= ТекущаяДатаСеанса()).Равно(Истина);
	ЮТест.ОжидаетЧто(Событие.Объект).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Событие.ОбъектНедвижимости).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Событие.Источник).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Событие.Описание).Равно("");
	ЮТест.ОжидаетЧто(Событие.Сумма).Равно(0);
	ЮТест.ОжидаетЧто(Событие.Валюта).Равно("");
	Идентификатор = Хроника.ДобавитьЗапись(Событие);
	ЮТест.ОжидаетЧто(ТипЗнч(Идентификатор)).Равно(Тип("УникальныйИдентификатор"));
	ЮТест.ОжидаетЧто(ПрочитатьХронику().Количество()).Равно(1);

КонецПроцедуры

Процедура ДобавлениеЗаписи() Экспорт

	Дом = СоздатьДом();
	Вещь = СоздатьВещь(Дом);
	Событие = СобытиеФикстуры(Вещь, Дом, "Проверка");
	Событие.Сумма = 125.50;
	Событие.Валюта = "EUR";
	Событие.Описание = "Магазин";
	Хроника.УдалитьПоИсточнику(Вещь);
	Первый = Хроника.ДобавитьЗапись(Событие);
	Второй = Хроника.ДобавитьЗапись(Событие);
	ЮТест.ОжидаетЧто(Первый <> Второй).Равно(Истина);
	Записи = ПрочитатьХронику(Вещь);
	ЮТест.ОжидаетЧто(Записи.Количество()).Равно(2);
	Для Каждого Запись Из Записи Цикл
		ПроверитьСобытие(Запись, Событие);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаменаСобытийИсточника() Экспорт

	Дом = СоздатьДом();
	Вещь = СоздатьВещь(Дом);
	Другая = СоздатьВещь(Дом);
	Чужие = ПрочитатьХронику(Другая);
	События = Новый Массив;
	События.Добавить(СобытиеФикстуры(Вещь, Дом, "Первое"));
	События.Добавить(СобытиеФикстуры(Вещь, Дом, "Второе"));
	Хроника.ОбновитьПоИсточнику(Вещь, События);
	ЮТест.ОжидаетЧто(ПрочитатьХронику(Вещь).Количество()).Равно(2);
	События.Очистить();
	События.Добавить(СобытиеФикстуры(Вещь, Дом, "Исправили"));
	Хроника.ОбновитьПоИсточнику(Вещь, События);
	ПроверитьСобытие(ЕдинственноеСобытие(Вещь), События[0]);
	Хроника.ОбновитьПоИсточнику(Вещь, События);
	ЮТест.ОжидаетЧто(ПрочитатьХронику(Вещь).Количество()).Равно(1);
	Хроника.ОбновитьПоИсточнику(Вещь, Новый Массив);
	ЮТест.ОжидаетЧто(ПрочитатьХронику(Вещь).Количество()).Равно(0);
	ПроверитьНаборы(Чужие, ПрочитатьХронику(Другая));

КонецПроцедуры

Процедура УдалениеСобытийИсточника() Экспорт

	Дом = СоздатьДом();
	Вещь = СоздатьВещь(Дом);
	Другая = СоздатьВещь(Дом);
	Чужие = ПрочитатьХронику(Другая);
	Хроника.ДобавитьЗапись(СобытиеФикстуры(Вещь, Дом, "Дополнительное"));
	Хроника.УдалитьПоИсточнику(Вещь);
	Хроника.УдалитьПоИсточнику(Вещь);
	ЮТест.ОжидаетЧто(ПрочитатьХронику(Вещь).Количество()).Равно(0);
	ПроверитьНаборы(Чужие, ПрочитатьХронику(Другая));

КонецПроцедуры

Процедура ПокупкаСоздание() Экспорт

	Объект = НоваяВещь(СоздатьДом());
	Объект.ДатаПокупки = Дата(2024, 1, 31);
	Объект.ЦенаПокупки = 12345.67;
	Объект.Продавец = "Магазин у дома";
	Объект.Записать();
	Покупка = ЕдинственнаяПокупка(Объект.Ссылка);
	Валюта = Константы.ОсновнаяВалюта.Получить();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Валюта)).Равно(Истина);
	ПроверитьПокупку(Покупка, Объект.ДатаПокупки, 12345.67, Валюта, Объект.Продавец);
	ПроверитьСобытиеПокупки(Покупка, Объект.Ссылка, Объект.ОбъектНедвижимости);

КонецПроцедуры

Процедура ПокупкаОбновление() Экспорт

	Вещь = СоздатьПокупку(СоздатьДом());
	Первая = ЕдинственнаяПокупка(Вещь).Ссылка;
	Объект = Вещь.ПолучитьОбъект();
	Объект.ДатаПокупки = Дата(2025, 2, 3);
	Объект.ЦенаПокупки = 250.25;
	Объект.Валюта = "EUR";
	Объект.Продавец = "Другой магазин";
	Объект.Записать();
	Покупка = ЕдинственнаяПокупка(Вещь);
	ЮТест.ОжидаетЧто(Покупка.Ссылка).Равно(Первая);
	ПроверитьПокупку(Покупка, Объект.ДатаПокупки, 250.25, "EUR", Объект.Продавец);
	ПроверитьСобытиеПокупки(Покупка, Вещь, Объект.ОбъектНедвижимости);

КонецПроцедуры

Процедура ПокупкаБезИзменений() Экспорт

	Вещь = СоздатьПокупку(СоздатьДом());
	Покупка = ЕдинственнаяПокупка(Вещь);
	До = ПрочитатьХронику(Покупка.Ссылка);
	Объект = Вещь.ПолучитьОбъект();
	Объект.Записать();
	Объект.Наименование = "Новое название вещи";
	Объект.Записать();
	ЮТест.ОжидаетЧто(ЕдинственнаяПокупка(Вещь).Ссылка).Равно(Покупка.Ссылка);
	ПроверитьНаборы(До, ПрочитатьХронику(Покупка.Ссылка));

КонецПроцедуры

Процедура ПокупкаОчисткаИПовторноеСоздание() Экспорт

	Вещь = СоздатьПокупку(СоздатьДом());
	Источник = ЕдинственнаяПокупка(Вещь).Ссылка;
	Объект = Вещь.ПолучитьОбъект();
	Объект.ДатаПокупки = Дата(1, 1, 1);
	Объект.ЦенаПокупки = 0;
	Объект.Продавец = "";
	Объект.Записать();
	// Пометка и физическое удаление одинаково допустимы по заданию.
	ЮТест.ОжидаетЧто(ПрочитатьПокупки(Вещь).Количество()).Равно(0);
	ЮТест.ОжидаетЧто(ПрочитатьХронику(Источник).Количество()).Равно(0);
	ПроверитьПерестроение();
	Объект.ЦенаПокупки = 99;
	Объект.Записать();
	Покупка = ЕдинственнаяПокупка(Вещь);
	ЮТест.ОжидаетЧто(Покупка.Сумма).Равно(99);
	ПроверитьСобытиеПокупки(Покупка, Вещь, Объект.ОбъектНедвижимости);
	ПроверитьПерестроение();

КонецПроцедуры

Процедура ПокупкаПоОдномуПолю() Экспорт

	Дом = СоздатьДом();
	Для Каждого Поле Из СтрРазделить("ДатаПокупки,ЦенаПокупки,Продавец", ",") Цикл
		Объект = НоваяВещь(Дом);
		Если Поле = "ДатаПокупки" Тогда
			Объект.ДатаПокупки = Дата(2023, 4, 5);
		ИначеЕсли Поле = "ЦенаПокупки" Тогда
			Объект.ЦенаПокупки = 10;
		Иначе
			Объект.Продавец = "Продавец";
		КонецЕсли;
		До = ТекущаяДатаСеанса();
		Объект.Записать();
		Покупка = ЕдинственнаяПокупка(Объект.Ссылка);
		Если Поле = "ДатаПокупки" Тогда
			ЮТест.ОжидаетЧто(Покупка.Дата).Равно(Объект.ДатаПокупки);
		Иначе
			ЮТест.ОжидаетЧто(Покупка.Дата >= До И Покупка.Дата <= ТекущаяДатаСеанса()).Равно(Истина);
		КонецЕсли;
		ПроверитьСобытиеПокупки(Покупка, Объект.Ссылка, Дом);
	КонецЦикла;

КонецПроцедуры

Процедура ВалютаБезПокупки() Экспорт

	Объект = НоваяВещь(СоздатьДом());
	Объект.Валюта = "EUR";
	Объект.Записать();
	ЮТест.ОжидаетЧто(ПрочитатьПокупки(Объект.Ссылка).Количество()).Равно(0);

КонецПроцедуры

Процедура ГарантияАвтоматическая() Экспорт

	Объект = НоваяВещь(СоздатьДом());
	Объект.ДатаПокупки = Дата(2024, 1, 31);
	Объект.ГарантияМесяцев = 1;
	Объект.Записать();
	Сохраненный = Объект.Ссылка.ПолучитьОбъект();
	ЮТест.ОжидаетЧто(Сохраненный.ГарантияНачало).Равно(Дата(2024, 1, 31));
	ЮТест.ОжидаетЧто(Сохраненный.ГарантияОкончание).Равно(Дата(2024, 2, 29));

КонецПроцедуры

Процедура ГарантияРучная() Экспорт

	Объект = НоваяВещь(СоздатьДом());
	Объект.ДатаПокупки = Дата(2024, 1, 31);
	Объект.ГарантияНачало = Дата(2024, 2, 5);
	Объект.ГарантияМесяцев = 12;
	Объект.ГарантияОкончание = Дата(2026, 6, 10);
	Объект.Записать();
	Объект = Объект.Ссылка.ПолучитьОбъект();
	Объект.ДатаПокупки = Дата(2024, 3, 1);
	Объект.ГарантияМесяцев = 24;
	Объект.Записать();
	Сохраненный = Объект.Ссылка.ПолучитьОбъект();
	ЮТест.ОжидаетЧто(Сохраненный.ГарантияНачало).Равно(Дата(2024, 2, 5));
	ЮТест.ОжидаетЧто(Сохраненный.ГарантияОкончание).Равно(Дата(2026, 6, 10));

КонецПроцедуры

Процедура ГарантияГраницы() Экспорт

	Пустая = Дата(1, 1, 1);
	ЮТест.ОжидаетЧто(ВещиКлиентСервер.ОкончаниеГарантии(Пустая, 12)).Равно(Пустая);
	ЮТест.ОжидаетЧто(ВещиКлиентСервер.ОкончаниеГарантии(Неопределено, 12)).Равно(Пустая);
	Для Каждого Срок Из СтрРазделить("0,-1", ",") Цикл
		ЮТест.ОжидаетЧто(ВещиКлиентСервер.ОкончаниеГарантии(Дата(2024, 1, 31), Число(Срок))).Равно(Пустая);
	КонецЦикла;
	ЮТест.ОжидаетЧто(ВещиКлиентСервер.ОкончаниеГарантии(Дата(2024, 1, 31), Неопределено)).Равно(Пустая);
	ЮТест.ОжидаетЧто(ВещиКлиентСервер.ОкончаниеГарантии(Дата(2023, 1, 31), 1)).Равно(Дата(2023, 2, 28));
	ЮТест.ОжидаетЧто(ВещиКлиентСервер.ОкончаниеГарантии(Дата(2024, 1, 31, 15, 30, 0), 1)).Равно(Дата(2024, 2, 29));
	ЮТест.ОжидаетЧто(ВещиКлиентСервер.ОкончаниеГарантии(Дата(2024, 2, 29), 12)).Равно(Дата(2025, 2, 28));
	ЮТест.ОжидаетЧто(ВещиКлиентСервер.ОкончаниеГарантии(Дата(2025, 3, 12), 24)).Равно(Дата(2027, 3, 12));

КонецПроцедуры

Процедура Перемещения() Экспорт

	Дом = СоздатьДом();
	Кухня = СоздатьМесто(Дом, "Кухня");
	Кладовка = СоздатьМесто(Дом, "Кладовка");
	Вещь = Вещи.СоздатьВещь("Дрель", Кухня);
	ПроверитьЗаголовок(Вещь, "Положили: Кухня", Перечисления.ТипыСобытийХроники.Перемещение, Вещь, Дом);
	СледующаяСекунда();
	Вещи.ПереместитьВещь(Вещь, Кладовка, "На хранение");
	ЮТест.ОжидаетЧто(ПрочитатьХронику(Вещь).Количество()).Равно(2);
	ПроверитьЗаголовок(Вещь, "Положили: Кухня", Перечисления.ТипыСобытийХроники.Перемещение, Вещь, Дом);
	ПроверитьЗаголовок(Вещь, "Перенесли: Кладовка", Перечисления.ТипыСобытийХроники.Перемещение, Вещь, Дом);
	До = ПрочитатьХронику(Вещь);
	Вещи.ПереместитьВещь(Вещь, Кладовка);
	ПроверитьНаборы(До, ПрочитатьХронику(Вещь));

КонецПроцедуры

Процедура Статусы() Экспорт

	Дом = СоздатьДом();
	Вещь = СоздатьВещь(Дом);
	ЮТест.ОжидаетЧто(ПрочитатьХронику(Вещь).НайтиСтроки(
		Новый Структура("ТипСобытия", Перечисления.ТипыСобытийХроники.ИзменениеСтатуса)).Количество()).Равно(0);
	СледующаяСекунда();
	Вещи.ИзменитьСтатус(Вещь, Перечисления.СтатусыВещей.Продано, "Отдали соседу");
	ПроверитьЗаголовок(Вещь, "Статус: Продано", Перечисления.ТипыСобытийХроники.ИзменениеСтатуса, Вещь, Дом);
	ЮТест.ОжидаетЧто(ПрочитатьХронику(Вещь).НайтиСтроки(
		Новый Структура("ТипСобытия", Перечисления.ТипыСобытийХроники.ИзменениеСтатуса)).Количество()).Равно(1);
	До = ПрочитатьХронику(Вещь);
	Вещи.ИзменитьСтатус(Вещь, Перечисления.СтатусыВещей.Продано);
	ПроверитьНаборы(До, ПрочитатьХронику(Вещь));

КонецПроцедуры

Процедура ДокументыИФото() Экспорт

	Дом = СоздатьДом();
	Вещь = СоздатьВещь(Дом);
	Фото = Вложения.Добавить(Вещь, Base64Значение("AAEC"), "Фото.jpg");
	Документ = Вложения.Добавить(Вещь, Base64Значение("AAEC"), "Инструкция.pdf");
	ПроверитьЗаголовок(Фото, "Добавили фото", Перечисления.ТипыСобытийХроники.ДобавлениеДокумента, Вещь, Дом);
	ПроверитьЗаголовок(Документ, "Добавили документ: Инструкция", Перечисления.ТипыСобытийХроники.ДобавлениеДокумента, Вещь, Дом);
	ЮТест.ОжидаетЧто(Вложения.СобытияДляХроники().Количество()).Равно(2);
	ПроверитьПерестроение();

КонецПроцедуры

Процедура ДокументыДомаИПокупки() Экспорт

	Дом = СоздатьДом();
	Вещь = СоздатьПокупку(Дом);
	Покупка = ЕдинственнаяПокупка(Вещь).Ссылка;
	ДокументДома = Вложения.Добавить(Дом, Base64Значение("AAEC"), "Договор.pdf");
	Чек = Вложения.Добавить(Покупка, Base64Значение("AAEC"), "Чек.pdf");
	ПроверитьЗаголовок(ДокументДома, "Добавили документ: Договор", Перечисления.ТипыСобытийХроники.ДобавлениеДокумента, Дом, Дом);
	ПроверитьЗаголовок(Чек, "Добавили документ: Чек", Перечисления.ТипыСобытийХроники.ДобавлениеДокумента, Вещь, Дом);
	ПроверитьПерестроение();

КонецПроцедуры

Процедура УдалениеДокумента() Экспорт

	Вещь = СоздатьВещь(СоздатьДом());
	Фото = Вложения.Добавить(Вещь, Base64Значение("AAEC"), "Фото.jpg");
	Документ = Вложения.Добавить(Вещь, Base64Значение("AAEC"), "Инструкция.pdf");
	Вложения.Удалить(Документ);
	ЮТест.ОжидаетЧто(ПрочитатьХронику(Документ).Количество()).Равно(0);
	ЮТест.ОжидаетЧто(ПрочитатьХронику(Фото).Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Вложения.СобытияДляХроники().Количество()).Равно(1);
	ПроверитьПерестроение();

КонецПроцедуры

Процедура ПерестроениеПослеДействий() Экспорт

	Дом = СоздатьДом();
	Вещь = СоздатьПокупку(Дом, СоздатьМесто(Дом, "Кухня"));
	Удаляемый = Вложения.Добавить(Вещь, Base64Значение("AAEC"), "Старое.pdf");
	Вложения.Добавить(Вещь, Base64Значение("AAEC"), "Фото.jpg");
	Вложения.Добавить(ЕдинственнаяПокупка(Вещь).Ссылка, Base64Значение("AAEC"), "Чек.pdf");
	СледующаяСекунда();
	Вещи.ПереместитьВещь(Вещь, СоздатьМесто(Дом, "Кладовка"));
	Вещи.ИзменитьСтатус(Вещь, Перечисления.СтатусыВещей.Хранится);
	Объект = Вещь.ПолучитьОбъект();
	Объект.ЦенаПокупки = 500;
	Объект.Записать();
	Вложения.Удалить(Удаляемый);
	ЮТест.ОжидаетЧто(ПрочитатьХронику().Количество()).Равно(6);
	ЮТест.ОжидаетЧто(Вещи.СобытияДляХроники().Количество()).Равно(4);
	ЮТест.ОжидаетЧто(Вложения.СобытияДляХроники().Количество()).Равно(2);
	ПроверитьПерестроение();

КонецПроцедуры

Процедура ПерестроениеПослеСменыДома() Экспорт

	Дом = СоздатьДом();
	Вещь = СоздатьПокупку(Дом, СоздатьМесто(Дом, "Кухня"));
