	ПроверитьИзоляцию();

КонецПроцедуры

Процедура ПроверитьИзоляцию() Экспорт

	Для Каждого Таблица Из СтрРазделить("Справочник.Вложения,РегистрСведений.ДанныеВложений,"
		+ "Справочник.Вещи,Справочник.ОбъектыНедвижимости,РегистрСведений.МестонахождениеВещей,"
		+ "РегистрСведений.СтатусыВещейИстория", ",") Цикл
		ПроверитьПустуюТаблицу(Таблица);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОтсутствиеДокументов()

	ПроверитьПустуюТаблицу("Справочник.Вложения");
	ПроверитьПустуюТаблицу("РегистрСведений.ДанныеВложений");

КонецПроцедуры

Процедура ПроверитьПустуюТаблицу(Таблица)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + Таблица);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ЮТест.ОжидаетЧто(Выборка.Количество).Равно(0);

КонецПроцедуры

Функция СоздатьДом()

	Объект = Справочники.ОбъектыНедвижимости.СоздатьЭлемент();
	Объект.Наименование = "Дом теста файлов";
	Объект.Тип = Перечисления.ТипыОбъектовНедвижимости.Квартира;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция СоздатьВещь()

	Объект = Справочники.Вещи.СоздатьЭлемент();
	Объект.Наименование = "Дрель теста файлов";
	Объект.ОбъектНедвижимости = СоздатьДом();
	Объект.Статус = Перечисления.СтатусыВещей.Используется;
	// Подготовка не зависит от сервиса вещей и не создаёт историю.
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция СоздатьДокументБезДанных()

	Объект = Справочники.Вложения.СоздатьЭлемент();
	Объект.Наименование = "Фото без файла";
	Объект.Предмет = СоздатьВещь();
	Объект.Расширение = "jpg";
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция ДанныеФикстуры()

	// Проверяем перенос байтов, а не декодирование картинки устройством.
	Возврат Base64Значение("AAECA//+");

КонецФункции

Функция ПрочитатьДанные(Файл)

	Запрос = Новый Запрос("ВЫБРАТЬ Данные ИЗ РегистрСведений.ДанныеВложений ГДЕ Вложение = &Файл");
	Запрос.УстановитьПараметр("Файл", Файл);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ПроверитьДвоичныеДанные(Фактические, Ожидаемые)

	ЮТест.ОжидаетЧто(ТипЗнч(Фактические)).Равно(Тип("ДвоичныеДанные"));
	ЮТест.ОжидаетЧто(Base64Строка(Фактические)).Равно(Base64Строка(Ожидаемые));

КонецПроцедуры

Процедура ПроверитьОтказДобавления(Предмет, Данные, ОжидаемыйТекст)

	ТекстОшибки = "";
	Попытка
		Вложения.Добавить(Предмет, Данные, "Файл.bin");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, ОжидаемыйТекст) > 0).Равно(Истина);
	// Эти отказы должны произойти до начала транзакции сервиса.
	ПроверитьОтсутствиеДокументов();

КонецПроцедуры

Процедура ПроверитьОсновноеФото(Вещь, Фото, Данные)

	ЮТест.ОжидаетЧто(Вещь.ПолучитьОбъект().ОсновноеФото).Равно(Фото);
	ЮТест.ОжидаетЧто(Фото.Предмет).Равно(Вещь);
	ЮТест.ОжидаетЧто(Фото.ТипДокумента).Равно(Перечисления.ТипыДокументов.Фотография);
	ПроверитьДвоичныеДанные(Вложения.Данные(Фото), Данные);

КонецПроцедуры

Процедура ПроверитьУдаление(Файл)

	ЮТест.ОжидаетЧто(Файл.ПолучитьОбъект().ПометкаУдаления).Равно(Истина);
	ЮТест.ОжидаетЧто(ПрочитатьДанные(Файл).Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Вложения.ЕстьДанные(Файл)).Равно(Ложь);
	ЮТест.ОжидаетЧто(Вложения.Данные(Файл)).Равно(Неопределено);

КонецПроцедуры
