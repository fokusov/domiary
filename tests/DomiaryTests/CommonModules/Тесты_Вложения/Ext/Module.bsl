Процедура ДобавлениеИзХранилища() Экспорт

	Данные = ДанныеФикстуры();
	Адрес = ПоместитьВоВременноеХранилище(Данные, Новый УникальныйИдентификатор);
	Попытка
		Файл = Вложения.ДобавитьИзХранилища(СоздатьВещь(), Адрес, "Чек.pdf",
			Перечисления.ТипыДокументов.Чек, "Чек дрели");
		ЮТест.ОжидаетЧто(Файл.Наименование).Равно("Чек дрели");
		ЮТест.ОжидаетЧто(Файл.ТипДокумента).Равно(Перечисления.ТипыДокументов.Чек);
		ПроверитьДвоичныеДанные(Вложения.Данные(Файл), Данные);
	Исключение
		УдалитьИзВременногоХранилища(Адрес);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьИзВременногоХранилища(Адрес);

КонецПроцедуры

Процедура НеверныеДанныеХранилища() Экспорт

	Вещь = СоздатьВещь();
	Адрес = ПоместитьВоВременноеХранилище("Не файл", Новый УникальныйИдентификатор);
	ТекстОшибки = "";
	Попытка
		Вложения.ДобавитьИзХранилища(Вещь, Адрес, "Файл.txt");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	УдалитьИзВременногоХранилища(Адрес);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки,
		"Не получилось прочитать файл. Попробуйте добавить его ещё раз.") > 0).Равно(Истина);
	ПроверитьОтсутствиеДокументов();

