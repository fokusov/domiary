Процедура ИсполняемыеСценарии() Экспорт

	Для Каждого ИмяТеста Из СтрРазделить(
		"ДобавлениеМетаданныхИДанных,ТипыИзображенийПоУмолчанию,ЯвныеТипИНазвание,ПустойТипПоУмолчанию,"
		+ "ИмяБезРасширения,ИмяСНесколькимиТочками,ИмяСТочкойВКонце,НазваниеСнимкаБезИмени,"
		+ "Ровно20МБ,Больше20МБ,НеопределенныеДанные,НулевыеДанные,ПустойПредмет,"
		+ "ЧтениеПустогоДокумента,ЧтениеДокументаБезДанных,ДобавлениеИзХранилища,НеверныеДанныеХранилища,"
		+ "ОсновноеФото,ЗаменаОсновногоФото,ОсновноеФотоИзХранилища,ПустаяВещьДляФото,"
		+ "РасширенияИзображений,ПросмотрИзображения,ПросмотрБезИзображения,"
		+ "УдалениеОсновногоФото,УдалениеОбычногоФайла,ПометкаЧерезОбъект,ПовторнаяЗаписьПомеченного,"
		+ "УдалениеСтарогоФото,УдалениеПустойСсылки", ",") Цикл
		// YAxUnit откатывает фикстуры, данные файлов и изменения вещей даже при падении.
		ЮТТесты.ДобавитьТест(ИмяТеста).ВТранзакции().Перед("ПроверитьИзоляцию");
	КонецЦикла;
	ЮТТесты.ДобавитьТест("КонтрольОчистки");

КонецПроцедуры

Процедура ДобавлениеМетаданныхИДанных() Экспорт

	Вещь = СоздатьВещь();
	Данные = ДанныеФикстуры();
	До = НачалоДня(ТекущаяДатаСеанса());
	Файл = Вложения.Добавить(Вещь, Данные, "Инструкция.PDF");
	Объект = Файл.ПолучитьОбъект();
	ЮТест.ОжидаетЧто(Объект.Предмет).Равно(Вещь);
	ЮТест.ОжидаетЧто(Объект.Наименование).Равно("Инструкция");
	ЮТест.ОжидаетЧто(Объект.ИмяФайла).Равно("Инструкция.PDF");
	ЮТест.ОжидаетЧто(Объект.Расширение).Равно("pdf");
	ЮТест.ОжидаетЧто(Объект.Размер).Равно(Данные.Размер());
	ЮТест.ОжидаетЧто(Объект.ТипДокумента).Равно(Перечисления.ТипыДокументов.Прочее);
	ЮТест.ОжидаетЧто(Объект.ДатаДокумента = До
		Или Объект.ДатаДокумента = НачалоДня(ТекущаяДатаСеанса())).Равно(Истина);
	Записи = ПрочитатьДанные(Файл);
	ЮТест.ОжидаетЧто(Записи.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ТипЗнч(Записи[0].Данные)).Равно(Тип("ХранилищеЗначения"));
	ПроверитьДвоичныеДанные(Записи[0].Данные.Получить(), Данные);
	ПроверитьДвоичныеДанные(Вложения.Данные(Файл), Данные);
	ЮТест.ОжидаетЧто(Вложения.ЕстьДанные(Файл)).Равно(Истина);

КонецПроцедуры

Процедура ТипыИзображенийПоУмолчанию() Экспорт

	Дом = СоздатьДом();
	Для Каждого Расширение Из СтрРазделить("jpg,JPEG,png,HEIC,webp", ",") Цикл
		Файл = Вложения.Добавить(Дом, ДанныеФикстуры(), "Фото." + Расширение);
		ЮТест.ОжидаетЧто(Файл.ТипДокумента).Равно(Перечисления.ТипыДокументов.Фотография);
		ЮТест.ОжидаетЧто(Файл.Расширение).Равно(НРег(Расширение));
		ЮТест.ОжидаетЧто(Файл.Предмет).Равно(Дом);
	КонецЦикла;

КонецПроцедуры

