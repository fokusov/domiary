		Перечисления.СтатусыВещей.Используется);
	История = ПрочитатьИсторию(Вещь, "МестонахождениеВещей");
	ЮТест.ОжидаетЧто(История.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(История[0].Место).Равно(Первое);
	ЮТест.ОжидаетЧто(История[1].Место).Равно(Второе);
	ЮТест.ОжидаетЧто(История[1].ОбъектНедвижимости).Равно(Второе.Владелец);
	ЮТест.ОжидаетЧто(История[1].Заметка).Равно("На дачу");
	ЮТест.ОжидаетЧто(ПрочитатьИсторию(Вещь, "СтатусыВещейИстория").Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Вещи.ПоследнееМесто()).Равно(Второе);

