Процедура ПроверитьИзоляцию()

	Для Каждого Таблица Из СтрРазделить("Справочник.Вещи,Справочник.МестаХранения,"
		+ "Справочник.ОбъектыНедвижимости,РегистрСведений.МестонахождениеВещей,"
		+ "РегистрСведений.СтатусыВещейИстория", ",") Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + Таблица);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		ЮТест.ОжидаетЧто(Выборка.Количество).Равно(0);
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьСостояние(Ключ, Значение)

	Запись = РегистрыСведений.СостояниеПриложения.СоздатьМенеджерЗаписи();
	Запись.Ключ = Ключ;
	Запись.Значение = Значение;
	Запись.Записать(Истина);

КонецПроцедуры

Функция СоздатьДом(Название)

	Объект = Справочники.ОбъектыНедвижимости.СоздатьЭлемент();
	Объект.Наименование = Название;
	Объект.Тип = Перечисления.ТипыОбъектовНедвижимости.Квартира;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция СоздатьМесто(Дом, Название)

	Объект = Справочники.МестаХранения.СоздатьЭлемент();
	Объект.Наименование = Название;
	Объект.Владелец = Дом;
	Объект.ТипМеста = Перечисления.ТипыМест.Помещение;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция СоздатьФикстуруВещи(Место, Дом = Неопределено)

	// Не зависим от СоздатьВещь и не создаём историю подготовки в текущую секунду.
	Объект = Справочники.Вещи.СоздатьЭлемент();
	Объект.Наименование = "Дрель";
	Объект.Место = Место;
	Если Дом = Неопределено Тогда
		Объект.ОбъектНедвижимости = Место.Владелец;
	Иначе
		Объект.ОбъектНедвижимости = Дом;
	КонецЕсли;
	Объект.Статус = Перечисления.СтатусыВещей.Используется;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция ПрочитатьИсторию(Вещь, ИмяРегистра)

	Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрСведений." + ИмяРегистра
		+ " ГДЕ Вещь = &Вещь УПОРЯДОЧИТЬ ПО Период");
	Запрос.УстановитьПараметр("Вещь", Вещь);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ЗаписатьМестоИстории(Вещь, Период, Место, Заметка)

	// Фиксированные прошлые даты исключают гонку с допустимым замещением в одну секунду.
	Запись = РегистрыСведений.МестонахождениеВещей.СоздатьМенеджерЗаписи();
	Запись.Вещь = Вещь;
	Запись.Период = Период;
	Запись.Место = Место;
	Запись.ОбъектНедвижимости = Место.Владелец;
	Запись.Заметка = Заметка;
	Запись.Записать();

КонецПроцедуры

Процедура ЗаписатьСтатусИстории(Вещь, Период, Статус, Заметка)

	Запись = РегистрыСведений.СтатусыВещейИстория.СоздатьМенеджерЗаписи();
	Запись.Вещь = Вещь;
	Запись.Период = Период;
	Запись.Статус = Статус;
	Запись.Заметка = Заметка;
	Запись.Записать();

КонецПроцедуры

Процедура ПроверитьПоля(Объект, Место, Дом, Статус)

	ЮТест.ОжидаетЧто(Объект.Место).Равно(Место);
	ЮТест.ОжидаетЧто(Объект.ОбъектНедвижимости).Равно(Дом);
	ЮТест.ОжидаетЧто(Объект.Статус).Равно(Статус);

КонецПроцедуры

Процедура ПроверитьСтрокуИстории(СтрокаИстории, Период, Событие, Заметка)

	ЮТест.ОжидаетЧто(СтрокаИстории.Период).Равно(Период);
	ЮТест.ОжидаетЧто(СтрокаИстории.Событие).Равно(Событие);
	ЮТест.ОжидаетЧто(СтрокаИстории.Заметка).Равно(Заметка);

КонецПроцедуры
