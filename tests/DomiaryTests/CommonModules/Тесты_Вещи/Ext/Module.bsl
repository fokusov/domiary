Процедура ИсполняемыеСценарии() Экспорт

	Для Каждого ИмяТеста Из СтрРазделить(
		"ЗаполнениеБезМест,ЗаполнениеПоследнимМестом,ЗаполнениеАрхивнымМестом,"
		+ "СозданиеПоУмолчанию,СозданиеСЯвнымМестом,СозданиеСПустымМестом,СозданиеБезНазвания,"
		+ "НоваяВещьПишетИсторию,ПеремещениеМеждуДомами,ПеремещениеБезИзменений,"
		+ "ИзменениеСтатуса,СтатусБезИзменений,ИсторияПорядокИТексты,ИсторияПустая,"
		+ "ЗаписьКакИзКарточки,ЗаписьБезИзменений,ИзменениеТолькоДома,"
		+ "ЗагрузкаНовойВещи,ЗагрузкаИзменений", ",") Цикл
		// Откат удаляет фикстуры, историю и изменения ключей даже после красного теста.
		ЮТТесты.ДобавитьТест(ИмяТеста).ВТранзакции().Перед("ПодготовитьИзоляцию");
	КонецЦикла;
	ЮТТесты.ДобавитьТест("КонтрольОчистки");

КонецПроцедуры

