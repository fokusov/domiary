Процедура НоваяВещьПишетИсторию() Экспорт

	Место = СоздатьМесто(СоздатьДом("Дом"), "Кухня");
	Объект = Справочники.Вещи.СоздатьЭлемент();
	Объект.Наименование = "Дрель";
	Объект.Место = Место;
	Объект.Статус = Перечисления.СтатусыВещей.Используется;
	ДоЗаписи = ТекущаяДатаСеанса();
	Объект.Записать();
	Места = ПрочитатьИсторию(Объект.Ссылка, "МестонахождениеВещей");
	Статусы = ПрочитатьИсторию(Объект.Ссылка, "СтатусыВещейИстория");
	ЮТест.ОжидаетЧто(Места.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Статусы.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Места[0].Место).Равно(Место);
	ЮТест.ОжидаетЧто(Места[0].ОбъектНедвижимости).Равно(Место.Владелец);
	ЮТест.ОжидаетЧто(Статусы[0].Статус).Равно(Объект.Статус);
	ЮТест.ОжидаетЧто(Места[0].Период >= ДоЗаписи И Места[0].Период <= ТекущаяДатаСеанса()).Равно(Истина);
	ЮТест.ОжидаетЧто(Вещи.ПоследнееМесто()).Равно(Место);

КонецПроцедуры

Процедура ПеремещениеМеждуДомами() Экспорт

