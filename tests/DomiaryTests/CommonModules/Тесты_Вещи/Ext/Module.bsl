Процедура ЗаписьКакИзКарточки() Экспорт

	Первое = СоздатьМесто(СоздатьДом("Первый дом"), "Кухня");
	Второе = СоздатьМесто(СоздатьДом("Второй дом"), "Гараж");
	Вещь = СоздатьФикстуруВещи(Первое);
	Объект = Вещь.ПолучитьОбъект();
	Объект.Место = Второе;
	Объект.Статус = Перечисления.СтатусыВещей.Хранится;
	Объект.ДополнительныеСвойства.Вставить("ЗаметкаИстории", "Из карточки");
	Объект.Записать();
	ПроверитьПоля(Вещь.ПолучитьОбъект(), Второе, Второе.Владелец, Перечисления.СтатусыВещей.Хранится);
	Места = ПрочитатьИсторию(Вещь, "МестонахождениеВещей");
	Статусы = ПрочитатьИсторию(Вещь, "СтатусыВещейИстория");
	ЮТест.ОжидаетЧто(Места.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Статусы.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Места[0].Место).Равно(Второе);
	ЮТест.ОжидаетЧто(Места[0].ОбъектНедвижимости).Равно(Второе.Владелец);
	ЮТест.ОжидаетЧто(Статусы[0].Статус).Равно(Перечисления.СтатусыВещей.Хранится);
	ЮТест.ОжидаетЧто(Места[0].Заметка).Равно("Из карточки");
	ЮТест.ОжидаетЧто(Статусы[0].Заметка).Равно("Из карточки");

