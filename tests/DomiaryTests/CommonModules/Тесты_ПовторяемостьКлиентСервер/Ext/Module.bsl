Процедура ПроверитьСледующую(Единица, Количество, Отсчет, Ожидаемая)

	Правило = ПовторяемостьКлиентСервер.НовоеПравило(Единица, Количество);
	ЮТест.ОжидаетЧто(ПовторяемостьКлиентСервер.СледующаяДата(Отсчет, Правило)).Равно(Ожидаемая);

КонецПроцедуры

Процедура ПроверитьБлижайшую(Единица, Количество, Отсчет, НаДату, Ожидаемая)

	Правило = ПовторяемостьКлиентСервер.НовоеПравило(Единица, Количество);
	ЮТест.ОжидаетЧто(ПовторяемостьКлиентСервер.БлижайшаяДатаНеРанее(Отсчет, Правило, НаДату)).Равно(Ожидаемая);

КонецПроцедуры

Процедура ПроверитьПредставление(Единица, Количество, Ожидаемое)

	Правило = ПовторяемостьКлиентСервер.НовоеПравило(Единица, Количество);
	ЮТест.ОжидаетЧто(ПовторяемостьКлиентСервер.ПредставлениеПравила(Правило)).Равно(Ожидаемое);

КонецПроцедуры

Процедура ПроверитьИсключение(Операция, Аргумент, ОжидаемыйТекст)

	ТекстОшибки = "";
	Правило = ПовторяемостьКлиентСервер.НовоеПравило("День", 1);
	Попытка
		Если Операция = "Конструктор" Тогда
			ПовторяемостьКлиентСервер.НовоеПравило("День", Аргумент);
		ИначеЕсли Операция = "Перечисление" Тогда
			ПовторяемостьКлиентСервер.ПравилоИзПеречисления(Аргумент, 1);
		ИначеЕсли Операция = "Следующая" Тогда
			ПовторяемостьКлиентСервер.СледующаяДата(Дата(2024, 1, 1), Аргумент);
		ИначеЕсли Операция = "Ближайшая" Тогда
			ПовторяемостьКлиентСервер.БлижайшаяДатаНеРанее(Дата(2024, 1, 1), Аргумент, Дата(2024, 1, 2));
		ИначеЕсли Операция = "Представление" Тогда
			ПовторяемостьКлиентСервер.ПредставлениеПравила(Аргумент);
		ИначеЕсли Операция = "ДатаОтсчета" Тогда
			ПовторяемостьКлиентСервер.СледующаяДата(Аргумент, Правило);
		ИначеЕсли Операция = "НаДату" Тогда
			ПовторяемостьКлиентСервер.БлижайшаяДатаНеРанее(Дата(2024, 1, 1), Правило, Аргумент);
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	// Проверяем и наличие исключения, и причину, чтобы случайная ошибка не дала зелёный тест.
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, ОжидаемыйТекст) > 0).Равно(Истина);

КонецПроцедуры
