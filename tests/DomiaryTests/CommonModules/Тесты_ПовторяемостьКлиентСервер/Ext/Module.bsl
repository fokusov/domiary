Процедура СозданиеПравил() Экспорт

	Для Каждого Единица Из СтрРазделить("День,Неделя,Месяц,Год", ",") Цикл
		Для Каждого Количество Из СтрРазделить("1,6", ",") Цикл
			Правило = ПовторяемостьКлиентСервер.НовоеПравило(Единица, Число(Количество));
			ЮТест.ОжидаетЧто(Правило.Единица).Равно(Единица);
			ЮТест.ОжидаетЧто(Правило.Количество).Равно(Число(Количество));
			ЮТест.ОжидаетЧто(ПовторяемостьКлиентСервер.ПравилоКорректно(Правило)).Равно(Истина);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура НекорректныеПравила() Экспорт

	Правила = Новый Массив;
	Правила.Добавить(Неопределено);
	Правила.Добавить(Новый Массив);
	Правила.Добавить("День");
	Правила.Добавить(Новый Структура);
	Правила.Добавить(Новый Структура("Единица", "День"));
	Правила.Добавить(Новый Структура("Количество", 1));
	Правила.Добавить(Новый Структура("Единица,Количество", "", 1));
	Правила.Добавить(Новый Структура("Единица,Количество", "Час", 1));
	Правила.Добавить(Новый Структура("Единица,Количество", 1, 1));
	Правила.Добавить(Новый Структура("Единица,Количество", "День", "1"));
	Правила.Добавить(Новый Структура("Единица,Количество", "День", Неопределено));
	Правила.Добавить(Новый Структура("Единица,Количество", "День", 0));
	Правила.Добавить(Новый Структура("Единица,Количество", "День", -1));
	Правила.Добавить(Новый Структура("Единица,Количество", "Месяц", 1.5));
	Для Каждого Правило Из Правила Цикл
		ЮТест.ОжидаетЧто(ПовторяемостьКлиентСервер.ПравилоКорректно(Правило)).Равно(Ложь);
	КонецЦикла;

КонецПроцедуры

Процедура ПравилоИзПеречисления() Экспорт

	Для Каждого Единица Из СтрРазделить("День,Неделя,Месяц,Год", ",") Цикл
		Значение = ПредопределенноеЗначение("Перечисление.ЕдиницыПовторения." + Единица);
		Правило = ПовторяемостьКлиентСервер.ПравилоИзПеречисления(Значение, 3);
		ЮТест.ОжидаетЧто(Правило.Единица).Равно(Единица);
		ЮТест.ОжидаетЧто(Правило.Количество).Равно(3);
	КонецЦикла;

КонецПроцедуры

